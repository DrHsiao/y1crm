<!DOCTYPE html>
<html lang="zh-Hant" style="color-scheme: @(IsDark ? "dark" : "light")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/@(ThemeName).css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="y1crm.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="@(IsDark ? "theme-dark" : "theme-light")">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool IsDark => HttpContext?.Request.Cookies["y1crm-theme"] == "dark";

    private string ThemeName => IsDark ? "material-dark" : "material";
}
