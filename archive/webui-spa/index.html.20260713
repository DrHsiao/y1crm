<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>y1crm — 客戶資料</title>
<script>try{var t=localStorage.getItem("y1crm-theme");if(t)document.documentElement.dataset.theme=t;}catch(e){}</script>
<style>
  /* ── 企業識別配色：亮色＝紅白、暗色＝紅黑 ─────────────────── */
  :root {
    --brand: #c8102e;            /* 企業紅 */
    --brand-hover: #a50d26;
    --brand-soft: #fbeef0;
    --focus: rgba(200, 16, 46, .3);
    --bg: #f4f5f7; --card: #ffffff; --text: #20242b; --muted: #6a7280;
    --line: #e2e5ea; --input-bg: #ffffff; --thead-bg: #f8f9fb;
    --topbar-bg: #c8102e; --topbar-text: #ffffff; --topbar-muted: rgba(255,255,255,.8);
    --topbar-line: rgba(255,255,255,.5); --topbar-border: #a50d26;
    --mark-bg: #ffffff; --mark-text: #c8102e;
    --shadow: 0 1px 3px rgba(16,24,40,.08);
    --danger: #b91c1c; --danger-bg: #fee2e2;
    --warn-bg: #fef3c7; --warn-line: #f59e0b; --warn-text: #78350f;
    --ok-bg: #dcfce7; --ok-text: #14532d; --info-bg: #e0f2fe; --info-text: #0c4a6e;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --brand: #d5253f; --brand-hover: #e73a54;
      --brand-soft: #2b151a; --focus: rgba(231, 58, 84, .4);
      --bg: #0e0e10; --card: #17171a; --text: #eceaea; --muted: #9a9aa4;
      --line: #2a2a31; --input-bg: #101013; --thead-bg: #1d1d22;
      --topbar-bg: #131316; --topbar-text: #f2f0f0; --topbar-muted: #9a9aa4;
      --topbar-line: #3a3a42; --topbar-border: #d5253f;
      --mark-bg: #d5253f; --mark-text: #ffffff;
      --shadow: 0 1px 3px rgba(0,0,0,.5);
      --danger: #f87171; --danger-bg: #3a1515;
      --warn-bg: #3a2e10; --warn-text: #fcd34d;
      --ok-bg: #10331d; --ok-text: #86efac; --info-bg: #0e2a3a; --info-text: #7dd3fc;
    }
  }
  :root[data-theme="dark"] {
    --brand: #d5253f; --brand-hover: #e73a54;
    --brand-soft: #2b151a; --focus: rgba(231, 58, 84, .4);
    --bg: #0e0e10; --card: #17171a; --text: #eceaea; --muted: #9a9aa4;
    --line: #2a2a31; --input-bg: #101013; --thead-bg: #1d1d22;
    --topbar-bg: #131316; --topbar-text: #f2f0f0; --topbar-muted: #9a9aa4;
    --topbar-line: #3a3a42; --topbar-border: #d5253f;
    --mark-bg: #d5253f; --mark-text: #ffffff;
    --shadow: 0 1px 3px rgba(0,0,0,.5);
    --danger: #f87171; --danger-bg: #3a1515;
    --warn-bg: #3a2e10; --warn-text: #fcd34d;
    --ok-bg: #10331d; --ok-text: #86efac; --info-bg: #0e2a3a; --info-text: #7dd3fc;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 16px/1.6 "Noto Sans TC", "Microsoft JhengHei", system-ui, sans-serif; }
  /* ── 頂列（ERP 標題列）────────────────────────────────────── */
  header { position: sticky; top: 0; z-index: 20; display: flex; align-items: center;
           gap: .85rem; padding: .55rem 1.4rem;
           background: var(--topbar-bg); color: var(--topbar-text);
           border-bottom: 2px solid var(--topbar-border); box-shadow: var(--shadow); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  header h1 { font-size: 1.18rem; margin: 0; letter-spacing: .02em; white-space: nowrap; }
  header .sub { color: var(--topbar-muted); font-size: .82rem; }
  .hdr-user { color: var(--topbar-text); font-size: .9rem; font-weight: 600;
              margin-left: auto; white-space: nowrap; }
  .brand-mark { width: 2.1rem; height: 2.1rem; border-radius: 7px; flex: none;
                background: #fff; object-fit: contain; padding: .12rem; }
  .topbtn { padding: .42rem .95rem; font-size: .88rem; border-radius: 6px; cursor: pointer;
            background: rgba(255,255,255,.14); color: var(--topbar-text); white-space: nowrap;
            border: 1px solid var(--topbar-line); transition: background .15s; }
  .topbtn:hover { background: rgba(255,255,255,.26); }
  /* 漢堡鈕（桌機隱藏，手機顯示）*/
  .nav-toggle { display: none; flex-direction: column; justify-content: center; gap: 4px;
                width: 2.4rem; height: 2.4rem; padding: 0 .55rem; flex: none; cursor: pointer;
                background: transparent; border: 1px solid var(--topbar-line); border-radius: 7px; }
  .nav-toggle span { display: block; height: 2px; background: var(--topbar-text); border-radius: 2px;
                     transition: transform .2s, opacity .2s; }
  header.nav-open .nav-toggle span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  header.nav-open .nav-toggle span:nth-child(2) { opacity: 0; }
  header.nav-open .nav-toggle span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  main { max-width: 1040px; margin: 0 auto; padding: 1.4rem 1.2rem; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px;
          padding: 1.5rem 1.7rem; box-shadow: var(--shadow); }
  h3 { margin: .2rem 0 .6rem; }
  .hint { color: var(--muted); font-size: .9rem; }
  /* ── 表單雙欄格線（ERP 密度）；窄螢幕收成單欄 ─────────────── */
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 1.8rem; }
  .form-grid > :not(.field), .field.wide { grid-column: 1 / -1; }
  @media (max-width: 760px) { .form-grid { grid-template-columns: 1fr; } }
  .section-title { margin: 1.7rem 0 .5rem; padding: .1rem 0 .3rem .65rem;
                   border-left: 4px solid var(--brand); border-bottom: 1px solid var(--line);
                   font-size: 1.02rem; letter-spacing: .04em; }
  .section-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .field { margin: .8rem 0; }
  label { display: block; margin-bottom: .25rem; font-weight: 600; }
  label .lh { font-weight: 400; color: var(--muted); font-size: .85rem; margin-left: .3rem; }
  label .req { color: var(--brand); }
  input, textarea, select {
    width: 100%; padding: .62rem .8rem; font-size: 1.05rem; color: var(--text);
    background: var(--input-bg); border: 1px solid var(--brand); border-radius: 6px;
  }
  input:focus, textarea:focus, select:focus { outline: 3px solid var(--focus); border-color: var(--brand); }
  /* 權限可視範圍：沒有 view_price 能力就整欄隱藏（API 也不會回傳資料）*/
  body:not(.can-price) .price-col { display: none !important; }
  .check-row { display: flex; gap: 1.1rem; flex-wrap: wrap; padding: .45rem 0; }
  .check-row label { font-weight: 400; display: inline-flex; align-items: center;
                     gap: .35rem; margin: 0; }
  .check-row input { width: auto; }
  .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .seg button { padding: .55rem 1.3rem; font-size: 1rem; border: none; cursor: pointer;
                background: var(--card); color: var(--text); border-left: 1px solid var(--line); }
  .seg button:first-child { border-left: none; }
  .seg button.on { background: var(--brand); color: #fff; }
  .btn { display: inline-flex; align-items: center; gap: .4rem; padding: .7rem 1.5rem;
         font-size: 1.05rem; font-weight: 600; border-radius: 6px;
         border: 1px solid var(--brand); background: var(--brand); color: #fff; cursor: pointer; }
  .btn:hover { background: var(--brand-hover); border-color: var(--brand-hover); }
  .btn.sm { padding: .35rem .8rem; font-size: .9rem; }
  .btn:disabled { opacity: .55; cursor: default; }
  .actions { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 1.5rem;
             padding-top: 1.2rem; border-top: 1px solid var(--line); }
  .actions .right { margin-left: auto; }
  .soft-warn { color: var(--warn-text); background: var(--warn-bg);
               border-left: 3px solid var(--warn-line); padding: .3rem .6rem;
               border-radius: 0 6px 6px 0; margin-top: .3rem; font-size: .9rem; }
  .field-info { color: var(--muted); font-size: .9rem; margin-top: .3rem; }
  .banner { padding: .7rem 1rem; border-radius: 6px; margin-top: 1.2rem; }
  /* ── 訊息浮層：固定於螢幕可視上緣，不隨捲動位置跑掉 ─────────── */
  /* 統一樣式：白底、紅框、紅字（id 選擇器蓋過 .banner.* 的各色底） */
  #toast { position: fixed; top: .9rem; left: 50%; transform: translateX(-50%);
           z-index: 60; margin: 0; width: max-content; max-width: min(92vw, 36rem);
           display: flex; align-items: baseline; gap: .9rem;
           background: #fff; color: var(--brand); border: 2px solid var(--brand);
           box-shadow: 0 6px 24px rgba(0,0,0,.28); animation: toast-in .18s ease-out; }
  #toast.hidden { display: none !important; }
  @keyframes toast-in { from { opacity: 0; transform: translate(-50%, -.7rem); }
                        to   { opacity: 1; transform: translate(-50%, 0); } }
  .toast-x { border: none; background: transparent; color: inherit; cursor: pointer;
             font-size: 1rem; padding: 0; line-height: 1; opacity: .65; flex-shrink: 0; }
  .toast-x:hover { opacity: 1; }
  .banner.info { background: var(--info-bg); color: var(--info-text); }
  .banner.success { background: var(--ok-bg); color: var(--ok-text); }
  .banner.warning { background: var(--warn-bg); color: var(--warn-text); }
  .banner.danger { background: var(--danger-bg); color: var(--danger); }
  .dup-panel { background: var(--warn-bg); color: var(--warn-text); border-radius: 6px;
               padding: .8rem 1rem; margin: 1rem 0; }
  .dup-panel a { color: inherit; font-weight: 700; }
  .dup-meta { opacity: .8; font-size: .9rem; margin-left: .4rem; }
  /* ── 資料表（ERP 列表）────────────────────────────────────── */
  table { width: 100%; border-collapse: collapse; background: var(--card); font-size: .98rem; }
  th, td { padding: .6rem .75rem; border-bottom: 1px solid var(--line); text-align: left;
           white-space: nowrap; }
  thead th { background: var(--thead-bg); border-bottom: 2px solid var(--brand);
             font-weight: 700; }
  td.addr { white-space: normal; }
  tbody tr { cursor: pointer; }
  tbody tr:hover { background: var(--brand-soft); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px;
                box-shadow: var(--shadow); }
  .meta { color: var(--muted); font-size: .9rem; margin-top: 1rem; }
  .code-badge { background: var(--brand-soft); border: 1px solid var(--line); border-radius: 6px;
                padding: .1rem .55rem; font-size: .95rem; color: var(--brand); font-weight: 600; }
  /* ── 頂列導覽 ─────────────────────────────────────────────── */
  .topnav { display: flex; gap: .25rem; margin-left: .9rem; }
  .topnav button { background: transparent; border: none; color: var(--topbar-muted);
                   padding: .48rem 1rem; font-size: .98rem; cursor: pointer; border-radius: 6px;
                   white-space: nowrap; }
  .topnav button:hover { color: var(--topbar-text); background: rgba(255,255,255,.12); }
  .topnav button.on { color: var(--topbar-text); background: rgba(255,255,255,.18); font-weight: 700; }

  /* ── 手機版：選單收進漢堡；頂列只留 logo + 登入者 ─────────────── */
  @media (max-width: 760px) {
    header { padding: .5rem .9rem; gap: .6rem; flex-wrap: wrap; }
    .nav-toggle { display: flex; }
    header h1 { font-size: 1.05rem; }
    .hdr-user { margin-left: auto; font-size: .85rem; }
    /* 收合時：選單與動作鈕隱藏，展開時以整列下拉呈現 */
    .topnav, header #theme-toggle, header .logout-btn { display: none; }
    header.nav-open .topnav {
      display: flex; flex-direction: column; gap: .15rem; flex-basis: 100%;
      margin: .5rem 0 .2rem; padding-top: .5rem; border-top: 1px solid var(--topbar-line); }
    header.nav-open .topnav button { text-align: left; padding: .7rem .8rem; font-size: 1rem; }
    header.nav-open #theme-toggle, header.nav-open .logout-btn {
      display: block; flex-basis: 100%; text-align: left; padding: .7rem .8rem; }
  }
  /* ── 行事曆 ───────────────────────────────────────────────── */
  .cal-card { padding: 1.1rem 1.2rem; }
  .cal-toolbar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: .9rem; }
  .cal-nav { display: flex; gap: .4rem; }
  .cal-title { margin: 0; min-width: 8.5rem; text-align: center; }
  .legend-row { display: flex; gap: .9rem; flex-wrap: wrap; margin-left: auto; }
  .legend-chip { display: inline-flex; align-items: center; gap: .35rem;
                 font-size: .88rem; color: var(--muted); }
  .legend-dot { width: .7rem; height: .7rem; border-radius: 50%; display: inline-block; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr);
              border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
  .cal-head { border: none; }
  .cal-head div { text-align: center; padding: .25rem 0; color: var(--muted);
                  font-size: .9rem; font-weight: 600; }
  .cal-cell { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
              min-height: 6.4rem; padding: .3rem .35rem; font-size: .85rem; overflow: hidden; }
  .cal-daynum { font-weight: 600; margin-bottom: .15rem; width: 1.6rem; height: 1.6rem;
                display: grid; place-items: center; border-radius: 50%; }
  .cal-cell.out { background: var(--bg); }
  .cal-cell.out .cal-daynum { color: var(--muted); font-weight: 400; }
  .cal-cell.today .cal-daynum { background: var(--brand); color: #fff; }
  .cal-ev { color: #fff; border-radius: 4px; padding: .06rem .4rem; margin: .18rem 0;
            cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cal-ev.done { opacity: .5; text-decoration: line-through; }
  .cal-more { color: var(--brand); cursor: pointer; font-size: .84rem; font-weight: 600; }
  /* ── 對話框 ───────────────────────────────────────────────── */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 50;
                   display: flex; align-items: center; justify-content: center; padding: 1rem; }
  .modal-card { background: var(--card); border: 1px solid var(--line); border-radius: 8px;
                border-top: 4px solid var(--brand); box-shadow: 0 10px 40px rgba(0,0,0,.35);
                width: min(28rem, 92vw); max-height: 85dvh; overflow: auto;
                padding: 1.2rem 1.4rem; }
  .modal-head { display: flex; justify-content: space-between; align-items: center;
                margin-bottom: .6rem; }
  .modal-head h3 { margin: 0; }
  #modal-body > div { margin: .35rem 0; }
  .modal-actions { display: flex; gap: .7rem; justify-content: flex-end; margin-top: 1.1rem; }
  /* ── OCR 辨識中遮罩（鎖住表單、防誤觸/關閉；顯示計時）──────── */
  #ocr-overlay { position: fixed; inset: 0; z-index: 70; display: flex;
                 align-items: center; justify-content: center; padding: 1rem;
                 background: rgba(0,0,0,.55); backdrop-filter: blur(2px);
                 cursor: progress; }
  #ocr-overlay .ocr-box { background: var(--card); border: 1px solid var(--line);
                 border-top: 4px solid var(--brand); border-radius: 10px;
                 box-shadow: 0 10px 40px rgba(0,0,0,.4); text-align: center;
                 width: min(24rem, 92vw); padding: 1.6rem 1.4rem; }
  #ocr-overlay .ocr-spin { width: 2.6rem; height: 2.6rem; margin: 0 auto .9rem;
                 border: .28rem solid var(--line); border-top-color: var(--brand);
                 border-radius: 50%; animation: ocr-spin 1s linear infinite; }
  @keyframes ocr-spin { to { transform: rotate(360deg); } }
  #ocr-overlay .ocr-title { font-size: 1.05rem; font-weight: 600; margin-bottom: .35rem; }
  #ocr-overlay .ocr-timer { font-size: 1.9rem; font-weight: 700; color: var(--brand);
                 font-variant-numeric: tabular-nums; margin: .2rem 0 .45rem; }
  #ocr-overlay .ocr-hint { color: var(--muted); font-size: .9rem; line-height: 1.5; }
  #ocr-overlay .ocr-bar { height: .35rem; border-radius: 999px; margin-top: 1rem;
                 background: var(--line); overflow: hidden; }
  #ocr-overlay .ocr-bar::before { content: ""; display: block; height: 100%; width: 40%;
                 background: var(--brand); border-radius: 999px;
                 animation: ocr-slide 1.3s ease-in-out infinite; }
  @keyframes ocr-slide { 0% { margin-left: -40%; } 100% { margin-left: 100%; } }
  /* ── 登入頁 ───────────────────────────────────────────────── */
  .login-wrap { min-height: 82dvh; display: flex; align-items: center; justify-content: center; }
  /* 登入頁動態小點（參考 antigravity.google）；表單區塊透明化，只留欄位與按鈕 */
  #login-fx { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .login-card { width: min(26rem, 94vw); background: transparent; border: none; box-shadow: none;
                position: relative; z-index: 1; }
  .login-card h2 { text-align: center; margin: .3rem 0; color: var(--brand); }
  .login-card .sub { text-align: center; color: var(--muted); margin-bottom: 1.4rem; }
  .pw-row { display: flex; gap: .5rem; }
  .pw-row input { flex: 1; }
  /* 欄位旁的單欄位查詢鈕（input group：輸入框與按鈕相連）；明細編輯模式下隱藏 */
  .input-row { display: flex; }
  .input-row input, .input-row select { flex: 1; min-width: 0; border-radius: 6px 0 0 6px; }
  .input-row input:focus { position: relative; z-index: 1; }
  /* 商品編輯既有商品時，隱藏欄位旁的查詢鈕（此時是編輯非查詢） */
  .mode-prod-edit .pq-btn { display: none; }
  .mode-prod-edit .input-row input, .mode-prod-edit .input-row select { border-radius: 6px; }
  .fq-btn { padding: .5rem 1.05rem; font-size: .95rem; white-space: nowrap;
            border-radius: 0 6px 6px 0; margin-left: -1px; }
  .mode-detail .fq-btn { display: none; }
  .mode-detail .input-row input { border-radius: 6px; }
  /* ── 客戶照片（僅明細編輯模式顯示；建檔後才能上傳）─────────── */
  #view-form:not(.mode-detail) .photo-section { display: none; }
  #view-form:not(.mode-detail) .formimg-section { display: none; }
  #view-form:not(.mode-detail) .todo-section { display: none; }
  /* ── 明細頁手風琴（各區塊可收合；僅明細模式作用）───────────── */
  .dsec-head { display: none; }                      /* 建檔模式不顯示收合頭 */
  #view-form.mode-detail .dsec-head {
    display: flex; align-items: center; gap: .55rem; cursor: pointer; user-select: none;
    margin: 1.1rem 0 .6rem; padding: .55rem .7rem; border-radius: 8px;
    border: 1px solid var(--line); border-left: 4px solid var(--brand);
    background: var(--brand-soft); }
  .dsec-head .dsec-chev { font-size: .75rem; color: var(--brand); transition: transform .18s; }
  .dsec-head .dsec-title { font-weight: 700; flex: 1; letter-spacing: .03em; }
  #view-form.mode-detail .dsection.collapsed .dsec-chev { transform: rotate(-90deg); }
  #view-form.mode-detail .dsection.collapsed .dsec-body { display: none; }
  /* ── 待辦事項 ─────────────────────────────────────────────── */
  .todo-item { border: 1px solid var(--line); border-left: 4px solid var(--brand);
               border-radius: 8px; padding: .6rem .8rem; margin-bottom: .6rem;
               background: var(--card); }
  .todo-item.done { border-left-color: #6b7280; opacity: .62; }
  .todo-item.done .todo-desc { text-decoration: line-through; }
  .todo-item.overdue { border-left-color: #e11d48; }
  .todo-top { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .todo-desc { font-weight: 600; flex: 1; min-width: 12rem; white-space: pre-wrap; }
  .todo-badge { font-size: .74rem; padding: .1rem .5rem; border-radius: 999px;
                border: 1px solid var(--line); color: var(--muted); white-space: nowrap; }
  .todo-badge.cat { background: var(--brand-soft); color: var(--brand); border-color: var(--brand); }
  .todo-badge.pri-high { background: #fdeaea; color: #c0182f; border-color: #e6a6ad; }
  .todo-badge.overdue { background: #fdeaea; color: #c0182f; border-color: #e6a6ad; }
  .todo-meta { color: var(--muted); font-size: .82rem; margin-top: .35rem;
               display: flex; gap: .8rem; flex-wrap: wrap; align-items: center; }
  .todo-acts { display: flex; gap: .3rem; }
  .todo-acts button { background: transparent; border: 1px solid var(--line); border-radius: 6px;
                      padding: .2rem .5rem; font-size: .8rem; cursor: pointer; color: var(--text); }
  .todo-acts button:hover { background: var(--brand-soft); }
  .todo-atts { display: flex; gap: .4rem; flex-wrap: wrap; margin-top: .5rem; }
  .todo-att { position: relative; }
  .todo-att img { width: 3.4rem; height: 3.4rem; object-fit: cover; border-radius: 5px;
                  border: 1px solid var(--line); cursor: pointer; }
  .todo-att .pdf { display: flex; align-items: center; justify-content: center;
                   width: 3.4rem; height: 3.4rem; border: 1px solid var(--line); border-radius: 5px;
                   font-size: .7rem; cursor: pointer; background: var(--brand-soft); color: var(--brand); }
  .todo-att .att-del { position: absolute; top: -6px; right: -6px; width: 1.15rem; height: 1.15rem;
                       border-radius: 50%; border: none; background: var(--brand); color: #fff;
                       font-size: .7rem; line-height: 1; cursor: pointer; }
  .todo-empty { color: var(--muted); font-size: .9rem; padding: .4rem 0; }
  .modal-field { margin-bottom: .7rem; }
  .modal-field label { display: block; font-size: .85rem; color: var(--muted); margin-bottom: .2rem; }
  .modal-row { display: flex; gap: .6rem; }
  .modal-row > * { flex: 1; }
  #formimg-view img { max-width: 12rem; max-height: 12rem; border-radius: 6px;
                 border: 1px solid var(--line); cursor: pointer; display: block; }
  #formimg-view .formimg-empty { color: var(--muted); font-size: .9rem; }
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
                gap: .8rem; margin-top: .4rem; }
  .photo-item { position: relative; border: 1px solid var(--line); border-radius: 8px;
                overflow: hidden; background: var(--bg); }
  .photo-item img { width: 100%; height: 9rem; object-fit: cover; display: block; cursor: pointer; }
  .photo-del { position: absolute; top: .35rem; right: .35rem; width: 1.7rem; height: 1.7rem;
               border-radius: 50%; border: none; cursor: pointer; display: grid; place-items: center;
               background: rgba(0,0,0,.55); color: #fff; font-size: .95rem; line-height: 1; }
  .photo-del:hover { background: var(--danger); }
  .photo-empty { color: var(--muted); font-size: .9rem; padding: .4rem 0; }
  /* OCR 匯入後「沒把握」的欄位：黃框提醒人工核對；使用者修改後自動解除 */
  input.ocr-uncertain, textarea.ocr-uncertain {
    border-color: var(--warn-line); background: var(--warn-bg); }
  .hidden { display: none !important; }
</style>
</head>
<body>

<header id="topbar" class="hidden">
  <button class="nav-toggle" id="nav-toggle" type="button" aria-label="開關選單" aria-expanded="false" aria-controls="topbar">
    <span></span><span></span><span></span>
  </button>
  <img class="brand-mark" id="brand-mark" src="/imagesLogoS.png" alt="企業圖示">
  <div class="brand-text">
    <h1 id="hdr-company">y1crm</h1>
    <span class="sub" id="hdr-branch"></span>
  </div>
  <nav class="topnav" id="topnav">
    <button id="nav-calendar" type="button" class="on" onclick="gotoCalendar()">行事曆</button>
    <button id="nav-customers" type="button" onclick="gotoCustomers()">客戶資料</button>
    <button id="nav-products" type="button" class="hidden" onclick="gotoProducts()">商品管理</button>
  </nav>
  <span class="hdr-user" id="hdr-user"></span>
  <button class="topbtn" id="theme-toggle" type="button">深色</button>
  <button class="topbtn logout-btn" onclick="logout()">登出</button>
</header>

<main>

  <!-- ── 登入 ─────────────────────────────────────────── -->
  <div id="view-login" class="login-wrap hidden">
    <canvas id="login-fx" aria-hidden="true"></canvas>
    <div class="card login-card">
      <h2 id="login-company">…</h2>
      <div class="sub" id="login-sub">請登入使用</div>
      <div class="field">
        <label for="login-username">帳號</label>
        <input id="login-username" autocomplete="username" autocapitalize="none" spellcheck="false">
      </div>
      <div class="field">
        <label for="login-password">密碼</label>
        <div class="pw-row">
          <input id="login-password" type="password" autocomplete="current-password" enterkeyhint="go">
          <button type="button" class="btn outline" id="pw-toggle">顯示</button>
        </div>
      </div>
      <div id="login-error" class="banner danger hidden"></div>
      <button class="btn" style="width:100%; justify-content:center; margin-top:1rem; padding:.85rem;"
              id="login-btn">登入</button>
    </div>
  </div>

  <!-- ── 行事曆（回訪提醒；復原自舊系統首頁）──────────────── -->
  <div id="view-calendar" class="hidden">
    <div class="card cal-card">
      <div class="cal-toolbar">
        <div class="cal-nav">
          <button class="btn outline sm" onclick="calShift(-1)">◀ 上月</button>
          <button class="btn outline sm" onclick="calToday()">今天</button>
          <button class="btn outline sm" onclick="calShift(1)">下月 ▶</button>
        </div>
        <h3 class="cal-title" id="cal-title"></h3>
        <div class="legend-row" id="cal-legend"></div>
      </div>
      <div class="cal-grid cal-head" id="cal-head"></div>
      <div class="cal-grid" id="cal-body"></div>
    </div>
  </div>

  <!-- ── 客戶表單（建檔 / 查詢 / 明細共用）───────────────── -->
  <div id="view-form" class="card form-grid hidden">
    <div id="form-head-entry">
      <div class="section-row">
        <div style="flex:1;">
          <h3 style="display:inline">客戶資料</h3>
          <span class="hint">任一欄位皆可作為查詢條件；建檔只需姓名，其餘可之後補登。</span>
        </div>
        <button type="button" class="btn sm" id="ocr-load-btn" onclick="warmupOcr()">🔌 載入模型</button>
        <button type="button" class="btn sm" id="ocr-camera-btn" onclick="$('ocr-camera').click()" disabled>📷 拍照匯入</button>
        <button type="button" class="btn sm" id="ocr-file-btn" onclick="$('ocr-file').click()" disabled>檔案匯入</button>
      </div>
      <input type="file" id="ocr-camera" accept="image/*" capture="environment" class="hidden">
      <input type="file" id="ocr-file" accept="image/*" class="hidden">
      <div id="ocr-status" class="field-info hidden"></div>
    </div>
    <div id="form-head-detail" class="hidden">
      <h3 style="display:inline" id="detail-name"></h3>
      <span class="code-badge" id="detail-code"></span>
    </div>

    <div id="created-banner" class="banner success hidden">建檔成功！可以繼續補齊其餘資料，完成後按「儲存」。</div>

    <div id="dup-panel" class="dup-panel hidden">
      <div style="font-weight:700; margin-bottom:.3rem;">提醒：發現 <span id="dup-count"></span> 筆可能重複的客戶</div>
      <ul id="dup-list" style="margin:0;"></ul>
    </div>

    <div class="dsection" id="ds-data">
    <div class="dsec-head" onclick="toggleDsec(event, this)">
      <span class="dsec-chev">▼</span><span class="dsec-title">客戶資料</span>
    </div>
    <div class="dsec-body form-grid">
    <h4 class="section-title">基本資料</h4>
    <div class="field">
      <label for="f-customer_code">客戶編號<span class="lh">（留空自動產生，如 C20260711-001）</span></label>
      <div class="input-row">
        <input id="f-customer_code" maxlength="20" autocomplete="off" spellcheck="false">
        <button type="button" class="btn outline fq-btn" onclick="queryByField('customer_code')">查詢</button>
      </div>
    </div>
    <div class="field">
      <label for="f-name">姓名 <span class="req">*</span></label>
      <div class="input-row">
        <input id="f-name" maxlength="50" autocomplete="off">
        <button type="button" class="btn outline fq-btn" onclick="queryByField('name')">查詢</button>
      </div>
    </div>
    <div class="field">
      <label for="f-national_id">身分證字號<span class="lh">（個資欄位，可留空）</span></label>
      <div class="input-row">
        <input id="f-national_id" maxlength="10" placeholder="A123456789" autocapitalize="characters"
               autocomplete="off" spellcheck="false">
        <button type="button" class="btn outline fq-btn" onclick="queryByField('national_id')">查詢</button>
      </div>
      <div id="warn-nid" class="soft-warn hidden"></div>
    </div>
    <div class="field">
      <label>性別</label>
      <div class="seg" id="seg-gender" data-value="">
        <button data-v="">—</button><button data-v="M">男</button><button data-v="F">女</button>
      </div>
    </div>
    <div class="field">
      <label for="f-birth_date">出生年月日<span class="lh df-hint"></span></label>
      <div class="input-row">
        <input id="f-birth_date" type="text" maxlength="10" autocomplete="off" spellcheck="false">
        <button type="button" class="btn outline fq-btn" onclick="queryByField('birth_date')">查詢</button>
      </div>
      <div id="birth-info" class="field-info hidden"></div>
    </div>
    <div class="field">
      <label for="f-registration_date">建檔日期<span class="lh">（留空＝建檔當天）</span></label>
      <input id="f-registration_date" type="text" maxlength="10" autocomplete="off" spellcheck="false">
    </div>

    <h4 class="section-title">聯絡方式</h4>
    <div class="field">
      <label for="f-phone_mobile">通訊電話（個人手機）</label>
      <input id="f-phone_mobile" type="tel" inputmode="tel" maxlength="20" placeholder="0912345678" autocomplete="off">
      <div id="warn-mobile" class="soft-warn hidden"></div>
    </div>
    <div class="field">
      <label for="f-phone_home">通訊電話（市話）</label>
      <input id="f-phone_home" type="tel" inputmode="tel" maxlength="20" placeholder="02-12345678" autocomplete="off">
    </div>
    <div class="field">
      <label for="f-email">電子信箱</label>
      <input id="f-email" type="email" maxlength="100" placeholder="name@example.com"
             autocapitalize="none" spellcheck="false" autocomplete="off">
      <div id="warn-email" class="soft-warn hidden"></div>
    </div>
    <div class="field">
      <label for="f-contact_name">聯絡人姓名<span class="lh">（家屬/照護者）</span></label>
      <input id="f-contact_name" maxlength="50" autocomplete="off">
    </div>
    <div class="field">
      <label for="f-contact_phone">聯絡人電話</label>
      <input id="f-contact_phone" type="tel" inputmode="tel" maxlength="20" autocomplete="off">
    </div>

    <div class="section-head" style="display:flex; align-items:center; gap:.6rem;">
      <h4 class="section-title" style="flex:1;">戶籍地址</h4>
      <button type="button" class="btn outline sm" onclick="copyMailing()">同通訊地址</button>
    </div>
    <div class="field"><label for="f-household_city">縣市</label>
      <input id="f-household_city" list="tw-cities" maxlength="20" autocomplete="off"></div>
    <div class="field"><label for="f-household_district">鄉鎮市區</label>
      <input id="f-household_district" maxlength="20" autocomplete="off"></div>
    <div class="field"><label for="f-household_village">村里</label>
      <input id="f-household_village" maxlength="20" autocomplete="off"></div>
    <div class="field wide"><label for="f-household_detail">路街/段/巷/弄/號/樓</label>
      <input id="f-household_detail" maxlength="100" autocomplete="off"></div>

    <div class="section-row">
      <h4 class="section-title" style="flex:1;">通訊地址</h4>
      <button type="button" class="btn outline sm" onclick="copyHousehold()">同戶籍地址</button>
    </div>
    <div class="field"><label for="f-mailing_city">縣市</label>
      <input id="f-mailing_city" list="tw-cities" maxlength="20" autocomplete="off"></div>
    <div class="field"><label for="f-mailing_district">鄉鎮市區</label>
      <input id="f-mailing_district" maxlength="20" autocomplete="off"></div>
    <div class="field"><label for="f-mailing_village">村里</label>
      <input id="f-mailing_village" maxlength="20" autocomplete="off"></div>
    <div class="field wide"><label for="f-mailing_detail">路街/段/巷/弄/號/樓</label>
      <input id="f-mailing_detail" maxlength="100" autocomplete="off"></div>

    <h4 class="section-title">其他</h4>
    <div class="field">
      <label>個資使用同意書</label>
      <div class="seg" id="seg-consent" data-value="">
        <button data-v="">—</button><button data-v="y">已簽署</button><button data-v="n">未簽署</button>
      </div>
    </div>
    <div class="field">
      <label for="f-consent_date">同意書簽署日期<span class="lh">（選「已簽署」時自動帶今天，可修改）</span></label>
      <input id="f-consent_date" type="text" maxlength="10" autocomplete="off" spellcheck="false">
    </div>
    <div class="field">
      <label>申請補助<span class="lh">（政府助聽器補助）</span></label>
      <div class="seg" id="seg-subsidy" data-value="">
        <button data-v="">—</button><button data-v="y">是</button><button data-v="n">否</button>
      </div>
    </div>
    <div class="field">
      <label>身份</label>
      <div class="seg" id="seg-identity" data-value="">
        <button data-v="">—</button><button data-v="mild">輕</button><button data-v="moderate">中</button>
        <button data-v="severe">重</button><button data-v="profound">極重</button>
      </div>
    </div>
    <div class="field wide">
      <label for="f-notes">備註</label>
      <textarea id="f-notes" rows="4"></textarea>
    </div>
    </div><!-- /dsec-body --></div><!-- /dsection ds-data -->

    <div class="dsection todo-section">
      <div class="dsec-head" onclick="toggleDsec(event, this)">
        <span class="dsec-chev">▼</span>
        <span class="dsec-title">待辦事項<span class="lh" id="todo-count"></span></span>
        <button type="button" class="btn sm" onclick="event.stopPropagation(); openTodoModal()">＋ 新增待辦</button>
      </div>
      <div class="dsec-body">
        <div id="todo-list"></div>
        <input type="file" id="todo-att-file" accept="image/*,application/pdf" class="hidden">
      </div>
    </div>

    <div class="dsection formimg-section">
      <div class="dsec-head" onclick="toggleDsec(event, this)">
        <span class="dsec-chev">▼</span>
        <span class="dsec-title">原始表單影像<span class="lh">（匯入/拍照的原稿，僅保留最新一份）</span></span>
        <button type="button" class="btn sm" id="formimg-camera-btn" onclick="event.stopPropagation(); $('formimg-camera').click()">📷 拍照</button>
        <button type="button" class="btn sm" onclick="event.stopPropagation(); $('formimg-file').click()">上傳／回補</button>
      </div>
      <div class="dsec-body">
        <input type="file" id="formimg-file" accept="image/*" class="hidden">
        <input type="file" id="formimg-camera" accept="image/*" capture="environment" class="hidden">
        <div id="formimg-view"></div>
        <div id="formimg-status" class="field-info hidden"></div>
      </div>
    </div>

    <div class="dsection photo-section">
      <div class="dsec-head" onclick="toggleDsec(event, this)">
        <span class="dsec-chev">▼</span>
        <span class="dsec-title">客戶照片<span class="lh" id="photo-count"></span></span>
        <button type="button" class="btn sm" id="photo-camera-btn" onclick="event.stopPropagation(); $('photo-camera').click()">📷 拍照</button>
        <button type="button" class="btn sm" onclick="event.stopPropagation(); $('photo-file').click()">上傳照片</button>
      </div>
      <div class="dsec-body">
        <input type="file" id="photo-file" accept="image/*" multiple class="hidden">
        <!-- capture：手機/平板直接開相機（後鏡頭）；桌機瀏覽器會忽略而退回檔案選擇 -->
        <input type="file" id="photo-camera" accept="image/*" capture="environment" class="hidden">
        <div id="photo-grid" class="photo-grid"></div>
        <div id="photo-status" class="field-info hidden"></div>
      </div>
    </div>

    <div class="actions" id="actions-entry">
      <button class="btn" id="btn-create" onclick="createCustomer()">建檔</button>
      <button class="btn outline" id="btn-query" onclick="queryCustomers()">查詢</button>
      <button class="btn ghost right" onclick="clearForm()">清空</button>
    </div>
    <div class="actions hidden" id="actions-detail">
      <button class="btn" id="btn-save" onclick="saveCustomer()">儲存</button>
      <button class="btn ghost" onclick="backToSearch()">回客戶查詢</button>
    </div>
    <p class="meta hidden" id="detail-meta"></p>
  </div>

  <!-- ── 查詢結果 ─────────────────────────────────────── -->
  <div id="view-results" class="hidden">
    <div class="actions" style="margin: 0 0 1rem;">
      <button class="btn outline" onclick="showView('form')">← 返回修改條件</button>
      <span style="align-self:center;" id="results-count"></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>客戶編號</th><th>姓名</th><th>性別</th><th>年齡</th>
          <th>手機</th><th>市話</th><th>通訊地址</th><th>建檔日</th>
        </tr></thead>
        <tbody id="results-body"></tbody>
      </table>
    </div>
    <div class="actions" id="pager" style="border-top:none; padding-top:0; margin-top:1rem;">
      <button class="btn sm" id="pager-prev" onclick="pagerGo(-1)">◀ 上一頁</button>
      <span style="align-self:center;" id="pager-info"></span>
      <button class="btn sm" id="pager-next" onclick="pagerGo(1)">下一頁 ▶</button>
    </div>
  </div>

  <!-- ── 商品管理（選單權限 products：admin/manager）───────── -->
  <div id="view-products" class="hidden">
    <div class="card">
      <div class="section-row">
        <h3 style="flex:1;" id="prod-form-title">新增商品</h3>
        <span class="hint" id="prod-meta"></span>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="p-category">分類<span class="req">＊</span></label>
          <div class="input-row">
            <select id="p-category"></select>
            <button type="button" class="btn outline fq-btn pq-btn" onclick="searchProducts()">查詢</button>
          </div>
        </div>
        <div class="field"><label for="p-brand">品牌<span class="req">＊</span></label>
          <div class="input-row">
            <input id="p-brand" maxlength="50" autocomplete="off" onkeydown="if(event.key==='Enter')searchProducts()">
            <button type="button" class="btn outline fq-btn pq-btn" onclick="searchProducts()">查詢</button>
          </div></div>
        <div class="field"><label for="p-model_name">型號<span class="req">＊</span></label>
          <div class="input-row">
            <input id="p-model_name" maxlength="100" autocomplete="off" onkeydown="if(event.key==='Enter')searchProducts()">
            <button type="button" class="btn outline fq-btn pq-btn" onclick="searchProducts()">查詢</button>
          </div></div>
        <div class="field"><label for="p-spec">規格補述<span class="lh">（如「312 電池 6 入」）</span></label>
          <input id="p-spec" maxlength="100" autocomplete="off"></div>
        <div class="field"><label for="p-product_code">商品編號 / SKU<span class="lh">（可空）</span></label>
          <input id="p-product_code" maxlength="30" autocomplete="off"></div>
        <div class="field"><label for="p-barcode">條碼<span class="lh">（EAN/UPC）</span></label>
          <input id="p-barcode" maxlength="50" autocomplete="off"></div>
        <div class="field"><label for="p-unit">計價單位</label>
          <input id="p-unit" maxlength="10" placeholder="台 / 顆 / 組 / 盒" autocomplete="off"></div>
        <div class="field"><label for="p-supplier">供應商</label>
          <div class="input-row">
            <input id="p-supplier" maxlength="100" autocomplete="off" onkeydown="if(event.key==='Enter')searchProducts()">
            <button type="button" class="btn outline fq-btn pq-btn" onclick="searchProducts()">查詢</button>
          </div></div>
        <div class="field price-col"><label for="p-list_price">建議售價</label>
          <input id="p-list_price" inputmode="decimal" autocomplete="off"></div>
        <div class="field price-col"><label for="p-cost_price">進價</label>
          <input id="p-cost_price" inputmode="decimal" autocomplete="off"></div>
        <div class="field"><label for="p-warranty_months">預設保固月數</label>
          <input id="p-warranty_months" inputmode="numeric" maxlength="3" autocomplete="off"></div>
        <div class="field">
          <label>狀態</label>
          <div class="seg" id="seg-p-active" data-value="1">
            <button data-v="1">在售</button><button data-v="0">停售</button>
          </div>
        </div>

        <h4 class="section-title ha-only">助聽器規格</h4>
        <div class="field ha-only"><label for="p-ha_form">機型</label><select id="p-ha_form"></select></div>
        <div class="field ha-only"><label for="p-ha_tech_level">等級</label><select id="p-ha_tech_level"></select></div>
        <div class="field ha-only"><label for="p-ha_channels">頻道數</label>
          <input id="p-ha_channels" inputmode="numeric" maxlength="3" autocomplete="off"></div>
        <div class="field ha-only"><label for="p-ha_battery">電池</label><select id="p-ha_battery"></select></div>
        <div class="field ha-only">
          <label>藍牙直連</label>
          <div class="seg" id="seg-p-bt" data-value="">
            <button data-v="">—</button><button data-v="y">有</button><button data-v="n">無</button>
          </div>
        </div>
        <div class="field ha-only">
          <label>電感線圈（T-coil）</label>
          <div class="seg" id="seg-p-tcoil" data-value="">
            <button data-v="">—</button><button data-v="y">有</button><button data-v="n">無</button>
          </div>
        </div>
        <div class="field ha-only"><label for="p-ha_ip_rating">防塵防水等級</label>
          <input id="p-ha_ip_rating" maxlength="10" placeholder="IP68" autocomplete="off"></div>
        <div class="field ha-only"><label for="p-subsidy_class">補助款別</label><select id="p-subsidy_class"></select></div>
        <div class="field wide ha-only">
          <label>適配聽損程度<span class="lh">（與客戶「身份」同一套代碼，可複選）</span></label>
          <div class="check-row" id="p-fit"></div>
        </div>

        <div class="field wide"><label for="p-compatible_models">適用機型<span class="lh">（配件用，如「Phonak RIC 全系列」）</span></label>
          <input id="p-compatible_models" maxlength="200" autocomplete="off"></div>
        <div class="field wide"><label for="p-notes">備註</label><textarea id="p-notes" rows="3"></textarea></div>
      </div>
      <div class="actions">
        <button class="btn" id="btn-prod-save" onclick="saveProduct()">建立商品</button>
        <button class="btn" onclick="clearProductForm()">清空</button>
        <button class="btn right hidden" id="btn-prod-del" onclick="deleteProduct()">刪除商品</button>
      </div>
    </div>

  </div>

  <!-- ── 商品查詢結果（獨立頁，比照客戶查詢結果）───────────── -->
  <div id="view-prod-results" class="hidden">
    <div class="actions" style="margin: 0 0 1rem;">
      <button class="btn outline" onclick="showView('products')">← 返回修改條件</button>
      <span style="align-self:center;" id="prod-count"></span>
      <label class="right" style="display:flex; align-items:center; gap:.4rem; align-self:center;">每頁
        <select id="prod-page-size" onchange="prodPage=1; renderProductPage()">
          <option value="10">10</option>
          <option value="20" selected>20</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>筆
      </label>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>分類</th><th>品牌</th><th>型號</th><th>規格</th>
          <th class="price-col">建議售價</th><th>保固</th><th>補助款</th><th>狀態</th>
        </tr></thead>
        <tbody id="prod-body"></tbody>
      </table>
    </div>
    <div class="actions" id="prod-pager" style="border-top:none; padding-top:0; margin-top:1rem;">
      <button class="btn sm" id="prod-prev" onclick="prodGoPage(-1)">◀ 上一頁</button>
      <span style="align-self:center;" id="prod-page-info"></span>
      <button class="btn sm" id="prod-next" onclick="prodGoPage(1)">下一頁 ▶</button>
    </div>
  </div>

  <!-- ── 訊息浮層（setStatus 統一出口；固定於可視上緣）────── -->
  <div id="toast" class="banner hidden" role="alert">
    <span id="toast-text"></span>
    <button type="button" class="toast-x" onclick="hideStatus()" title="關閉">✕</button>
  </div>

  <!-- ── OCR 辨識中遮罩（處理期間鎖住整個畫面，防關閉/誤觸）──── -->
  <div id="ocr-overlay" class="hidden" aria-live="polite" aria-busy="true">
    <div class="ocr-box">
      <div class="ocr-spin"></div>
      <div class="ocr-title">辨識中，請稍候…</div>
      <div class="ocr-timer" id="ocr-timer">已處理 0 秒</div>
      <div class="ocr-hint" id="ocr-hint">正在讀取表單內容，完成後會自動填入欄位。<br>處理期間請勿離開或關閉本頁。</div>
      <div class="ocr-bar"></div>
    </div>
  </div>

  <!-- ── 通用對話框（行事曆明細等）────────────────────────── -->
  <div id="modal-overlay" class="modal-overlay hidden">
    <div class="modal-card">
      <div class="modal-head">
        <h3 id="modal-title"></h3>
        <button class="btn ghost sm" type="button" onclick="closeModal()">✕</button>
      </div>
      <div id="modal-body"></div>
    </div>
  </div>

  <datalist id="tw-cities">
    <option value="臺北市"><option value="新北市"><option value="桃園市"><option value="臺中市">
    <option value="臺南市"><option value="高雄市"><option value="基隆市"><option value="新竹市">
    <option value="嘉義市"><option value="新竹縣"><option value="苗栗縣"><option value="彰化縣">
    <option value="南投縣"><option value="雲林縣"><option value="嘉義縣"><option value="屏東縣">
    <option value="宜蘭縣"><option value="花蓮縣"><option value="臺東縣"><option value="澎湖縣">
    <option value="金門縣"><option value="連江縣">
  </datalist>
</main>

<script>
"use strict";

const $ = id => document.getElementById(id);
const TEXT_FIELDS = ["customer_code","name","national_id","phone_mobile","phone_home","email",
  "contact_name","contact_phone","household_city","household_district","household_village",
  "household_detail","mailing_city","mailing_district","mailing_village","mailing_detail","notes"];
const DATE_FIELDS = ["birth_date","registration_date","consent_date"];

// ══ 日期過濾器（民國年模組）══════════════════════════════════
// 系統內部（API / DB / 查詢條件）一律使用西元 ISO（YYYY-MM-DD）；
// 民國年只存在於兩個邊界：使用者輸入解析（tryToISO）與畫面顯示（fromISO 系列）。
// ★ 要移除民國年：把下方 const DF = ROC_FILTER 改成 GREGORIAN_FILTER 即可，
//   其餘程式完全不用動（ROC_FILTER 整段可刪）。
function _parseDateInput(s, rocYear) {
  s = (s ?? "").trim();
  if (!s) return "";
  const m = s.match(/^(\d{1,4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})$/);
  if (!m) return null;
  let y = +m[1];
  if (rocYear && y < 1000) y += 1911;   // 民國 → 西元；輸入 4 位數視為已是西元
  if (y < 1900 || y > 2200) return null;
  const mo = +m[2], dd = +m[3];
  const d = new Date(y, mo - 1, dd);
  if (d.getFullYear() !== y || d.getMonth() !== mo - 1 || d.getDate() !== dd) return null;
  return `${y}-${String(mo).padStart(2,"0")}-${String(dd).padStart(2,"0")}`;
}
const ROC_FILTER = {
  hint: "民國年",
  placeholder: "民國年，如 114/07/11",
  yearLen: 3,                                       // 自動補斜線用：民國年 3 碼
  tryToISO: s => _parseDateInput(s, true),          // 輸入 → 西元 ISO；不合法回傳 null
  fromISO(iso) {                                    // 西元 ISO → 民國顯示
    if (!iso) return "";
    const [y, mo, dd] = iso.split("-");
    return `${+y - 1911}/${mo}/${dd}`;
  },
  fromISODateTime(s) {                              // "YYYY-MM-DD HH:MM" → "YYY/MM/DD HH:MM"
    if (!s) return "";
    const i = s.indexOf(" ");
    return i < 0 ? this.fromISO(s) : this.fromISO(s.slice(0, i)) + s.slice(i);
  },
  yearLabel: y => `民國 ${y - 1911} 年`,            // 行事曆標題用
};
const GREGORIAN_FILTER = {
  hint: "西元",
  placeholder: "西元，如 2026/07/11",
  yearLen: 4,                                       // 自動補斜線用：西元年 4 碼
  tryToISO: s => _parseDateInput(s, false),
  fromISO: iso => iso ?? "",
  fromISODateTime: s => s ?? "",
  yearLabel: y => `${y} 年`,
};
const DF = ROC_FILTER;   // ← 政權更換時改用 GREGORIAN_FILTER

function dfToISO(v, label) {
  const iso = DF.tryToISO(v);
  if (iso === null) throw new Error(`「${label}」格式不正確，請輸入${DF.placeholder}。`);
  return iso;
}

// 日期輸入自動補斜線：年(DF.yearLen 碼)/月(2)/日(2)。輸入純數字即自動格式化。
function maskDate(v) {
  const L = DF.yearLen;
  const dg = (v || "").replace(/\D/g, "").slice(0, L + 4);
  if (dg.length <= L) return dg;
  if (dg.length <= L + 2) return dg.slice(0, L) + "/" + dg.slice(L);
  return dg.slice(0, L) + "/" + dg.slice(L, L + 2) + "/" + dg.slice(L + 2);
}
function attachDateMask(el) {
  if (!el || el._masked) return;
  el._masked = true;
  el.addEventListener("input", () => {
    const atEnd = el.selectionStart === el.value.length;
    el.value = maskDate(el.value);
    if (atEnd) el.setSelectionRange(el.value.length, el.value.length);
  });
}

// 日期欄位的佔位符與提示文字跟著過濾器走，並掛上自動補斜線
for (const f of DATE_FIELDS) { $("f-" + f).placeholder = DF.placeholder; attachDateMask($("f-" + f)); }
document.querySelectorAll(".df-hint").forEach(el => el.textContent = `（${DF.hint}）`);

let detailId = null;      // null=建檔/查詢模式，數字=明細編輯模式
let confirmCreate = false; // 有疑似重複時需按兩次建檔

// ── API ─────────────────────────────────────────────────────
async function api(path, opts = {}) {
  const res = await fetch(path, {
    headers: { "Content-Type": "application/json" },
    credentials: "same-origin",
    ...opts,
  });
  if (res.status === 401) { showLogin(); throw new Error("未登入"); }
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.detail || `HTTP ${res.status}`);
  return data;
}

// ── 檢視切換 ─────────────────────────────────────────────────
function showView(name) {
  for (const v of ["login","calendar","form","results","products","prod-results"]) $("view-"+v).classList.add("hidden");
  $("view-"+name).classList.remove("hidden");
  $("topbar").classList.toggle("hidden", name === "login");
  if (name !== "login") {
    $("nav-calendar").classList.toggle("on", name === "calendar");
    $("nav-customers").classList.toggle("on", name === "form" || name === "results");
    $("nav-products").classList.toggle("on", name === "products" || name === "prod-results");
  }
}

// 手機漢堡選單開關
function closeNav() { $("topbar").classList.remove("nav-open"); $("nav-toggle").setAttribute("aria-expanded", "false"); }
$("nav-toggle").addEventListener("click", () => {
  const open = $("topbar").classList.toggle("nav-open");
  $("nav-toggle").setAttribute("aria-expanded", open ? "true" : "false");
});

// 明細頁手風琴：點區塊頭展開/收合
function toggleDsec(ev, head) {
  ev.stopPropagation();
  head.closest(".dsection").classList.toggle("collapsed");
}
// 進入明細時的預設：各區塊全部收合（含客戶資料）
function applyAccordionDefaults() {
  document.querySelectorAll("#view-form .dsection").forEach(el => el.classList.add("collapsed"));
}

// 行事曆已遷至獨立頁（MPA 過渡期：本檔只服務客戶資料/商品管理）
function gotoCalendar() { location.href = "/calendar"; }
function gotoCustomers() { closeNav(); enterEntryMode(); showView("form"); location.hash = "customers"; }

function showLogin() {
  // 登入頁已遷出：導向 /login，成功後帶回原本要去的位置
  location.href = "/login?next=" + encodeURIComponent("/" + location.hash);
}

async function boot() {
  try {
    const me = await api("/api/me");
    $("hdr-company").textContent = me.company_name || "y1crm";
    $("hdr-branch").textContent = me.branch_name || "";
    $("hdr-user").textContent = `${me.realname}（${me.level}）`;
    // 權限套用：選單可視 + 價格欄位可視（真正的關卡在 API，這裡只是外觀）
    const menus = me.menus || [];
    document.body.classList.toggle("can-price", (me.caps || []).includes("view_price"));
    for (const [k, id] of Object.entries(
        { calendar: "nav-calendar", customers: "nav-customers", products: "nav-products" }))
      $(id).classList.toggle("hidden", !menus.includes(k));
    enterEntryMode();
    $("topbar").classList.remove("hidden");
    // 過渡期 hash 路由：#products／#customer/<id>／其餘＝客戶建檔查詢
    const m = location.hash.match(/^#customer\/(\d+)$/);
    if (location.hash === "#products" && menus.includes("products")) gotoProducts();
    else if (m) { showView("form"); openDetail(+m[1]); }
    else if (menus.includes("customers")) showView("form");
    else if (menus.includes("products")) gotoProducts();
    else if (menus.includes("calendar")) location.replace("/calendar");
    else { showView("form"); setStatus("您的帳號尚未開通任何選單權限，請聯絡管理員。", "warning"); }
  } catch { /* 401 → showLogin 已處理 */ }
}

// ── 登入/登出 ───────────────────────────────────────────────
async function login() {
  $("login-error").classList.add("hidden");
  try {
    await api("/api/login", { method: "POST", body: JSON.stringify({
      username: $("login-username").value, password: $("login-password").value }) });
    $("login-password").value = "";
    boot();
  } catch (e) {
    $("login-error").textContent = e.message;
    $("login-error").classList.remove("hidden");
  }
}

async function logout() {
  try { await api("/api/logout", { method: "POST" }); } catch {}
  showLogin();
}

$("login-btn").onclick = login;
$("login-password").addEventListener("keydown", e => { if (e.key === "Enter") login(); });
$("login-username").addEventListener("keydown", e => { if (e.key === "Enter") $("login-password").focus(); });
$("pw-toggle").onclick = () => {
  const i = $("login-password"), show = i.type === "password";
  i.type = show ? "text" : "password";
  $("pw-toggle").textContent = show ? "隱藏" : "顯示";
};

// ── 主題切換：亮＝紅白、暗＝紅黑（記在 localStorage，預設跟系統）──
function currentTheme() {
  return document.documentElement.dataset.theme ||
    (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
}
function refreshThemeBtn() {
  $("theme-toggle").textContent = currentTheme() === "dark" ? "淺色" : "深色";
}
$("theme-toggle").onclick = () => {
  const next = currentTheme() === "dark" ? "light" : "dark";
  document.documentElement.dataset.theme = next;
  try { localStorage.setItem("y1crm-theme", next); } catch {}
  refreshThemeBtn();
};
refreshThemeBtn();

// ── 三態選鈕 ─────────────────────────────────────────────────
for (const segId of ["seg-gender","seg-consent","seg-subsidy","seg-identity",
                     "seg-p-active","seg-p-bt","seg-p-tcoil"]) {
  $(segId).querySelectorAll("button").forEach(btn => {
    btn.onclick = () => {
      setSeg(segId, btn.dataset.v);
      if (segId === "seg-consent" && btn.dataset.v === "y" && !$("f-consent_date").value)
        $("f-consent_date").value = DF.fromISO(today());
    };
  });
}
function setSeg(segId, v) {
  $(segId).dataset.value = v;
  $(segId).querySelectorAll("button").forEach(b => b.classList.toggle("on", b.dataset.v === v));
}
const getSeg = segId => $(segId).dataset.value;

// ── 表單資料 ─────────────────────────────────────────────────
function formData() {
  const d = {};
  for (const f of TEXT_FIELDS) d[f] = $("f-"+f).value;
  for (const f of DATE_FIELDS) d[f] = dfToISO($("f-"+f).value, FIELD_LABELS[f]);  // 民國→西元
  d.gender = getSeg("seg-gender");
  d.consent_signed = getSeg("seg-consent");
  d.subsidy_applied = getSeg("seg-subsidy");
  d.identity = getSeg("seg-identity");
  return d;
}

function fillForm(row) {
  for (const f of TEXT_FIELDS) $("f-"+f).value = row[f] ?? "";
  for (const f of DATE_FIELDS) $("f-"+f).value = DF.fromISO(row[f] ?? "");  // 西元→民國
  setSeg("seg-gender", row.gender ?? "");
  setSeg("seg-consent", row.consent_signed == null ? "" : (row.consent_signed ? "y" : "n"));
  setSeg("seg-subsidy", row.subsidy_applied == null ? "" : (row.subsidy_applied ? "y" : "n"));
  setSeg("seg-identity", row.identity ?? "");
  refreshSoftChecks();
}

function clearForm() {
  fillForm({});
  setSeg("seg-gender",""); setSeg("seg-consent",""); setSeg("seg-subsidy",""); setSeg("seg-identity","");
  hideDup(); hideStatus(); confirmCreate = false;
  clearOcrMarks(); ocrPendingPhoto = null;
  refreshSoftChecks();
}

const today = () => new Date().toISOString().slice(0, 10);

// ── 建檔 / 查詢 / 明細 ──────────────────────────────────────
function enterEntryMode() {
  detailId = null;
  clearForm();
  clearPhotos();
  clearTodos();
  $("formimg-view").innerHTML = ""; setNote("formimg-status", "");
  $("view-form").classList.remove("mode-detail");
  $("form-head-entry").classList.remove("hidden");
  $("form-head-detail").classList.add("hidden");
  $("actions-entry").classList.remove("hidden");
  $("actions-detail").classList.add("hidden");
  $("detail-meta").classList.add("hidden");
  $("created-banner").classList.add("hidden");
  refreshOcrState();
}

async function openDetail(id, created = false) {
  try {
    const row = await api(`/api/customers/${id}`);
    detailId = id;
    fillForm(row);
    applyDetailHeader(row);
    renderFormImage(row);
    loadPhotos();
    loadTodos();
    applyAccordionDefaults();
    hideDup(); hideStatus(); confirmCreate = false;
    $("view-form").classList.add("mode-detail");
    $("form-head-entry").classList.add("hidden");
    $("form-head-detail").classList.remove("hidden");
    $("actions-entry").classList.add("hidden");
    $("actions-detail").classList.remove("hidden");
    $("created-banner").classList.toggle("hidden", !created);
    showView("form");
    window.scrollTo(0, 0);
  } catch (e) { setStatus(e.message, "danger"); }
}

function applyDetailHeader(row) {
  $("detail-name").textContent = row.name;
  $("detail-code").textContent = row.customer_code;
  $("detail-meta").textContent =
    `建檔時間：${DF.fromISODateTime(row.created_at ?? "")}‧最後更新：${DF.fromISODateTime(row.updated_at ?? "")}` +
    (row.updated_by ? `（修改者：${row.updated_by}）` : "");
  $("detail-meta").classList.remove("hidden");
}

function backToSearch() { enterEntryMode(); showView("form"); window.scrollTo(0, 0); }

async function createCustomer() {
  hideStatus();
  let d;
  try { d = formData(); } catch (e) { setStatus(e.message, "danger"); return; }
  if (!d.name.trim()) {
    setStatus("請至少輸入「姓名」後再建檔，其餘欄位可於建檔後補登。", "danger");
    return;
  }
  await refreshDup();
  const dups = $("dup-list").children.length;
  if (dups > 0 && !confirmCreate) {
    confirmCreate = true;
    setStatus(`發現 ${dups} 筆可能重複的客戶（上方清單可點開確認）。確定不是同一人，請再按一次「建檔」。`, "warning");
    return;
  }
  setBusy(true);
  try {
    const r = await api("/api/customers", { method: "POST", body: JSON.stringify(d) });
    await openDetail(r.id, true);
    if (ocrPendingPhoto) {   // OCR 匯入/拍照的原稿 → 存為「原始表單影像」單一份（非多檔畫廊）
      try {
        const id = await putFormImage(ocrPendingPhoto.file);
        renderFormImage({ form_image_id: id });
      } catch { /* 留底失敗不影響建檔 */ }
      ocrPendingPhoto = null;
    }
  } catch (e) { setStatus(e.message, "danger"); }
  finally { setBusy(false); }
}

let lastQueryCond = {};   // 翻頁時重送同一組條件
let pagerPage = 1;

async function runQuery(cond, page = 1) {
  hideStatus(); setBusy(true);
  try {
    const r = await api("/api/customers/query",
      { method: "POST", body: JSON.stringify({ ...cond, page }) });
    if (r.total === 0) {
      setStatus("查無符合條件的客戶。若要新增，確認姓名後按「建檔」即可。", "info");
      return;
    }
    if (r.total === 1) { await openDetail(r.rows[0].id); return; }
    lastQueryCond = cond;
    pagerPage = r.page;
    $("results-count").textContent = `共 ${r.total} 筆符合`;
    $("pager-info").textContent = `第 ${r.page} / ${r.pages} 頁`;
    $("pager-prev").disabled = r.page <= 1;
    $("pager-next").disabled = r.page >= r.pages;
    $("pager").classList.toggle("hidden", r.pages <= 1);
    renderResults(r.rows);
    showView("results");
    window.scrollTo(0, 0);
  } catch (e) { setStatus(e.message, "danger"); }
  finally { setBusy(false); }
}

function pagerGo(d) { runQuery(lastQueryCond, pagerPage + d); }

function queryCustomers() {
  try { return runQuery(formData()); }
  catch (e) { setStatus(e.message, "danger"); }
}

// 欄位旁查詢鈕：只用該欄位單獨當條件（底部「查詢」= 全部欄位 AND）
const FIELD_LABELS = {
  customer_code: "客戶編號", name: "姓名",
  national_id: "身分證字號", birth_date: "出生年月日",
  registration_date: "建檔日期", consent_date: "同意書簽署日期",
};
function queryByField(f) {
  let v = $("f-" + f).value.trim();
  if (v && DATE_FIELDS.includes(f)) {   // 查詢條件同樣民國→西元後才送 API
    try { v = dfToISO(v, FIELD_LABELS[f]); }
    catch (e) { setStatus(e.message, "danger"); return; }
  }
  return runQuery(v ? { [f]: v } : {});  // 空白＝不設條件，列出全部（每頁 10 筆）
}

async function saveCustomer() {
  hideStatus();
  let d;
  try { d = formData(); } catch (e) { setStatus(e.message, "danger"); return; }
  if (!d.name.trim()) { setStatus("姓名不可空白。", "danger"); return; }
  if (!d.customer_code.trim()) { setStatus("客戶編號不可空白。", "danger"); return; }
  setBusy(true);
  try {
    const row = await api(`/api/customers/${detailId}`, { method: "PUT", body: JSON.stringify(d) });
    applyDetailHeader(row);
    $("created-banner").classList.add("hidden");
    setStatus("已儲存。", "success");
  } catch (e) { setStatus(e.message, "danger"); }
  finally { setBusy(false); }
}

function ageText(birth) {
  if (!birth) return "—";
  const b = new Date(birth + "T00:00:00"), now = new Date();
  let age = now.getFullYear() - b.getFullYear();
  const m = now.getMonth() - b.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < b.getDate())) age--;
  return `${age} 歲`;
}

function renderResults(rows) {
  const esc = s => (s ?? "").toString()
    .replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");
  $("results-body").innerHTML = rows.map(c => `
    <tr onclick="openDetail(${c.id})">
      <td>${esc(c.customer_code)}</td>
      <td>${esc(c.name)}</td>
      <td>${c.gender === "M" ? "男" : c.gender === "F" ? "女" : "—"}</td>
      <td>${ageText(c.birth_date)}</td>
      <td>${esc(c.phone_mobile) || "—"}</td>
      <td>${esc(c.phone_home) || "—"}</td>
      <td class="addr">${esc([c.mailing_city,c.mailing_district,c.mailing_detail].filter(Boolean).join("")) || "—"}</td>
      <td>${esc(DF.fromISO(c.registration_date ?? "")) || "—"}</td>
    </tr>`).join("");
}

// ── 客戶照片（多張上傳/檢視/刪除；僅明細編輯模式）────────────
async function loadPhotos() {
  if (detailId === null) return;
  try {
    const r = await api(`/api/customers/${detailId}/photos`);
    renderPhotos(r.rows);
  } catch { /* 401 已導回登入 */ }
}

function renderPhotos(rows) {
  $("photo-count").textContent = rows.length ? `（${rows.length} 張）` : "";
  $("photo-grid").innerHTML = rows.length ? rows.map(p => `
    <div class="photo-item">
      <img src="/api/photos/${p.id}" alt="客戶照片" loading="lazy"
           title="${esc(p.filename ?? "")}‧${esc(DF.fromISODateTime(p.created_at ?? ""))}${p.created_by ? "‧" + esc(p.created_by) : ""}"
           onclick="showPhoto(${p.id})">
      <button type="button" class="photo-del" title="刪除這張照片" onclick="deletePhoto(${p.id})">✕</button>
    </div>`).join("")
    : `<div class="photo-empty">尚無照片，按「上傳照片」新增（可一次選多張）。</div>`;
}

function clearPhotos() {
  $("photo-grid").innerHTML = "";
  $("photo-count").textContent = "";
  setNote("photo-status", "");
}

function showPhoto(pid) {
  openModal("客戶照片", `
    <img src="/api/photos/${pid}" style="max-width:100%; border-radius:6px;">
    <div class="modal-actions"><button class="btn" onclick="closeModal()">關閉</button></div>`);
}

// ── 原始表單影像（單一份；連結存 customers.form_image_id）──────────────
function renderFormImage(row) {
  const id = row && row.form_image_id;
  $("formimg-view").innerHTML = id
    ? `<img src="/api/photos/${id}?t=${Date.now()}" alt="原始表單影像" loading="lazy"
           title="點擊放大檢視" onclick="showPhoto(${id})">`
    : `<div class="formimg-empty">尚無原始表單影像，可按「上傳／回補」加入（僅保留最新一份）。</div>`;
}

// 縮到 1600 後 PUT 到單一份端點；回傳新影像 id
async function putFormImage(file) {
  const blob = await shrinkImage(file);   // 預設 1600，維持清晰
  const res = await fetch(`/api/customers/${detailId}/form-image?filename=${encodeURIComponent(file.name || "客戶資料表.jpg")}`, {
    method: "PUT", credentials: "same-origin",
    headers: { "Content-Type": blob.type || "image/jpeg" }, body: blob });
  if (res.status === 401) { showLogin(); throw new Error("未登入"); }
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.detail || `HTTP ${res.status}`);
  return data.id;
}

// 明細模式：使用者上傳／回補原始表單影像
async function uploadFormImage(file) {
  if (detailId === null) return;
  setNote("formimg-status", "上傳中…");
  try {
    const id = await putFormImage(file);
    renderFormImage({ form_image_id: id });
    setNote("formimg-status", "");
    loadPhotos();   // 舊份已刪、畫廊排除規則，重整以防殘影
  } catch (e) { setNote("formimg-status", "上傳失敗：" + e.message); }
}

// ── 客戶待辦事項 ─────────────────────────────────────────────
let todoEditId = null, todoAttTarget = null;
const TODO_PRIORITIES = [["", "—"], ["high", "高"], ["normal", "中"], ["low", "低"]];

async function ensureCodes() { if (!CODES) CODES = await api("/api/codes"); }

async function loadTodos() {
  if (detailId === null) return;
  try {
    await ensureCodes();   // 分類要顯示中文
    const r = await api(`/api/customers/${detailId}/todos`);
    renderTodos(r.rows);
  } catch { /* 401 已導回登入 */ }
}

function clearTodos() { $("todo-list").innerHTML = ""; $("todo-count").textContent = ""; }

function renderTodos(rows) {
  const undone = rows.filter(t => !t.done_at).length;
  $("todo-count").textContent = rows.length ? `（未完成 ${undone} / 共 ${rows.length}）` : "";
  $("todo-list").innerHTML = rows.length ? rows.map(todoItemHtml).join("")
    : `<div class="todo-empty">尚無待辦，按「＋ 新增待辦」加入。</div>`;
}

function todoItemHtml(t) {
  const done = !!t.done_at;
  const overdue = !done && t.due_at && t.due_at.slice(0, 16) < nowLocalMin();
  const cls = "todo-item" + (done ? " done" : "") + (overdue ? " overdue" : "");
  const cat = t.category ? `<span class="todo-badge cat">${esc(codeLabel("todo_category", t.category))}</span>` : "";
  const pri = t.priority === "high" ? `<span class="todo-badge pri-high">高</span>`
            : t.priority === "low" ? `<span class="todo-badge">低</span>` : "";
  const due = t.due_at ? `${overdue ? '<span class="todo-badge overdue">逾期</span>' : ""}⏰ ${esc(DF.fromISODateTime(t.due_at))}` : "";
  const doneInfo = done ? `✔ ${esc(DF.fromISODateTime(t.done_at))}${t.done_by ? "‧" + esc(t.done_by) : ""}` : "";
  const atts = (t.attachments || []).map(a => todoAttHtml(a)).join("");
  return `<div class="${cls}">
    <div class="todo-top">
      ${cat}${pri}
      <span class="todo-desc">${esc(t.description)}</span>
      <div class="todo-acts">
        <button title="${done ? "取消完成" : "標記完成"}" onclick="toggleTodoDone(${t.id}, ${!done})">${done ? "↩︎" : "✔ 完成"}</button>
        <button title="編輯" onclick="openTodoModal(${t.id})">✎</button>
        <button title="加附件" onclick="pickTodoAttachment(${t.id})">📎</button>
        <button title="刪除" onclick="deleteTodoItem(${t.id})">✕</button>
      </div>
    </div>
    <div class="todo-meta">
      ${due ? `<span>${due}</span>` : ""}
      ${doneInfo ? `<span>${doneInfo}</span>` : ""}
      <span>建立 ${esc(DF.fromISODateTime(t.created_at))}${t.created_by ? "‧" + esc(t.created_by) : ""}</span>
    </div>
    ${atts ? `<div class="todo-atts">${atts}</div>` : ""}
  </div>`;
}

function todoAttHtml(a) {
  const isPdf = (a.mime || "").includes("pdf");
  const inner = isPdf
    ? `<div class="pdf" onclick="window.open('/api/todo-attachments/${a.id}')">PDF</div>`
    : `<img src="/api/todo-attachments/${a.id}" loading="lazy" onclick="window.open('/api/todo-attachments/${a.id}')">`;
  return `<div class="todo-att">${inner}<button class="att-del" title="刪除附件" onclick="delTodoAttachment(${a.id})">✕</button></div>`;
}

// 本地時間 "YYYY-MM-DDTHH:MM"（比較逾期用）
function nowLocalMin() {
  const d = new Date(), p = n => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}

async function openTodoModal(tid) {
  await ensureCodes();
  todoEditId = tid || null;
  let t = { category: "", description: "", priority: "", due_at: "" };
  if (tid) {
    const list = await api(`/api/customers/${detailId}/todos`);
    t = list.rows.find(x => x.id === tid) || t;
  }
  const catOpts = `<option value="">—</option>` +
    (CODES["todo_category"] || []).map(c => `<option value="${c.key}"${c.key===t.category?" selected":""}>${esc(c.value)}</option>`).join("");
  const priOpts = TODO_PRIORITIES.map(([k, v]) => `<option value="${k}"${k===(t.priority||"")?" selected":""}>${v}</option>`).join("");
  let dueDate = "", dueTime = "";
  if (t.due_at) { const s = t.due_at.slice(0, 16); dueDate = DF.fromISO(s.slice(0,10)); dueTime = s.slice(11,16); }
  openModal(tid ? "編輯待辦" : "新增待辦", `
    <div class="modal-field"><label>說明 <span style="color:var(--brand)">*</span></label>
      <textarea id="td-desc" rows="3">${esc(t.description)}</textarea></div>
    <div class="modal-row">
      <div class="modal-field"><label>分類</label><select id="td-cat">${catOpts}</select></div>
      <div class="modal-field"><label>優先度</label><select id="td-pri">${priOpts}</select></div>
    </div>
    <div class="modal-row">
      <div class="modal-field"><label>時間（${DF.hint}，可空）</label>
        <input id="td-date" placeholder="${DF.placeholder}" value="${dueDate}"></div>
      <div class="modal-field"><label>時刻</label><input id="td-time" type="time" value="${dueTime}"></div>
    </div>
    <div id="td-err" class="banner danger hidden" style="margin:.4rem 0"></div>
    <div class="modal-actions">
      <button class="btn" onclick="saveTodo()">${tid ? "儲存" : "新增"}</button>
      <button class="btn outline" onclick="closeModal()">取消</button>
    </div>`);
  attachDateMask($("td-date"));   // 待辦時間欄也自動補斜線
}

async function saveTodo() {
  const desc = $("td-desc").value.trim();
  if (!desc) { showTdErr("請填寫說明。"); return; }
  let due_at = null;
  const dv = $("td-date").value.trim();
  if (dv) {
    const iso = DF.tryToISO(dv);
    if (iso === null) { showTdErr(`時間日期格式不正確，請輸入${DF.placeholder}。`); return; }
    due_at = iso + "T" + ($("td-time").value || "00:00");
  }
  const body = { description: desc, category: $("td-cat").value || null,
                 priority: $("td-pri").value || null, due_at };
  try {
    if (todoEditId) await api(`/api/todos/${todoEditId}`, { method: "PUT", body: JSON.stringify(body) });
    else await api(`/api/customers/${detailId}/todos`, { method: "POST", body: JSON.stringify(body) });
    closeModal();
    await loadTodos();   // 後端以 created_at 遞減回傳，新筆自動在第 1 筆
  } catch (e) { showTdErr(e.message); }
}
function showTdErr(msg) { const el = $("td-err"); el.textContent = msg; el.classList.remove("hidden"); }

async function toggleTodoDone(tid, done) {
  try { await api(`/api/todos/${tid}`, { method: "PUT", body: JSON.stringify({ done }) }); await loadTodos(); }
  catch (e) { setStatus(e.message, "danger"); }
}

async function deleteTodoItem(tid) {
  if (!confirm("確定刪除這筆待辦？其附件也會一併移除。")) return;
  try { await api(`/api/todos/${tid}`, { method: "DELETE" }); await loadTodos(); }
  catch (e) { setStatus(e.message, "danger"); }
}

function pickTodoAttachment(tid) { todoAttTarget = tid; $("todo-att-file").click(); }

async function uploadTodoAttachment(tid, file) {
  try {
    const isImg = (file.type || "").startsWith("image/");
    const body = isImg ? await shrinkImage(file) : file;   // 圖片縮 1600；PDF 原樣
    const res = await fetch(`/api/todos/${tid}/attachments?filename=${encodeURIComponent(file.name)}`, {
      method: "POST", credentials: "same-origin",
      headers: { "Content-Type": body.type || file.type || "application/octet-stream" }, body });
    if (res.status === 401) { showLogin(); return; }
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.detail || `HTTP ${res.status}`);
    await loadTodos();
  } catch (e) { setStatus("附件上傳失敗：" + e.message, "danger"); }
}

async function delTodoAttachment(aid) {
  if (!confirm("刪除這個附件？")) return;
  try { await api(`/api/todo-attachments/${aid}`, { method: "DELETE" }); await loadTodos(); }
  catch (e) { setStatus(e.message, "danger"); }
}

$("todo-att-file").addEventListener("change", e => {
  const file = e.target.files[0]; e.target.value = "";
  if (file && todoAttTarget) uploadTodoAttachment(todoAttTarget, file);
});

async function deletePhoto(pid) {
  if (!confirm("確定刪除這張照片？刪除後無法復原。")) return;
  try {
    await api(`/api/photos/${pid}`, { method: "DELETE" });
    await loadPhotos();
  } catch (e) { setStatus(e.message, "danger"); }
}

// 上傳前先在瀏覽器縮圖（最長邊 1600px、JPEG 85%），照片不會撐爆資料庫
async function shrinkImage(file, maxEdge = 1600) {
  const MAX = maxEdge;
  const bmp = await createImageBitmap(file, { imageOrientation: "from-image" }).catch(() => null);
  if (!bmp) return file;   // 瀏覽器解不開就原樣上傳，交給伺服器大小上限把關
  const scale = Math.min(1, MAX / Math.max(bmp.width, bmp.height));
  if (scale === 1 && file.type === "image/jpeg" && file.size < 800 * 1024) return file;
  const cv = document.createElement("canvas");
  cv.width = Math.round(bmp.width * scale);
  cv.height = Math.round(bmp.height * scale);
  cv.getContext("2d").drawImage(bmp, 0, 0, cv.width, cv.height);
  const blob = await new Promise(r => cv.toBlob(r, "image/jpeg", .85));
  return blob || file;
}

async function uploadPhoto(file) {
  const body = await shrinkImage(file);
  const res = await fetch(`/api/customers/${detailId}/photos?filename=${encodeURIComponent(file.name)}`, {
    method: "POST", credentials: "same-origin",
    headers: { "Content-Type": body.type || "image/jpeg" }, body });
  if (res.status === 401) { showLogin(); throw new Error("未登入"); }
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.detail || `HTTP ${res.status}`);
  return data;
}

async function handlePhotoFiles(files) {
  if (!files.length || detailId === null) return;
  let done = 0;
  const errs = [];
  setNote("photo-status", `上傳中…（0/${files.length}）`);
  for (const f of files) {
    try { await uploadPhoto(f); done++; }
    catch (err) { errs.push(`${f.name}：${err.message}`); }
    setNote("photo-status", `上傳中…（${done}/${files.length}）`);
  }
  setNote("photo-status", errs.length ? `完成 ${done} 張；失敗 ${errs.length} 張 — ${errs.join("、")}` : "");
  await loadPhotos();
}

for (const inputId of ["photo-file", "photo-camera"]) {
  $(inputId).addEventListener("change", e => {
    const files = [...e.target.files];
    e.target.value = "";   // 清空才能連續拍照/重選同一檔
    handlePhotoFiles(files);
  });
}

// 原始表單影像：拍照/上傳（單一檔，回補即替換）
for (const inputId of ["formimg-file", "formimg-camera"]) {
  $(inputId).addEventListener("change", e => {
    const file = e.target.files[0];
    e.target.value = "";
    if (file) uploadFormImage(file);
  });
}

// 桌機（滑鼠為主要指標）沒有相機可拍，隱藏拍照鈕；手機/平板顯示
if (!matchMedia("(pointer: coarse)").matches) {
  $("photo-camera-btn").classList.add("hidden");
  $("formimg-camera-btn").classList.add("hidden");
}

// ── 商品管理（選單權限 products）─────────────────────────────
let CODES = null, productRows = [], productEditId = null;
let prodFiltered = [], prodPage = 1, prodSearched = false;
const PRODUCT_INPUT_IDS = ["product_code","barcode","brand","model_name","spec","unit","supplier",
  "list_price","cost_price","warranty_months","ha_channels","ha_ip_rating","compatible_models","notes"];
const PRODUCT_SELECT_IDS = ["category","ha_form","ha_tech_level","ha_battery","subsidy_class"];

const codeLabel = (cat, key) =>
  ((CODES && CODES[cat]) || []).find(c => c.key === key)?.value ?? (key || "—");

function fillSelect(id, cat, blankLabel = "—") {
  $(id).innerHTML = `<option value="">${blankLabel}</option>` +
    (CODES[cat] || []).map(c => `<option value="${c.key}">${esc(c.value)}</option>`).join("");
}

async function gotoProducts() {
  closeNav();
  showView("products");
  location.hash = "products";
  try {
    if (!CODES) {
      CODES = await api("/api/codes");
      fillSelect("p-category", "product_category", "請選擇");
      fillSelect("p-ha_form", "ha_form");
      fillSelect("p-ha_tech_level", "ha_tech_level");
      fillSelect("p-ha_battery", "battery_type");
      fillSelect("p-subsidy_class", "subsidy_class");
      $("p-fit").innerHTML = (CODES.identity || []).map(c =>
        `<label><input type="checkbox" value="${c.key}">${esc(c.value)}</label>`).join("");
      toggleHaFields();
    }
    await loadProducts();
  } catch (e) { setStatus(e.message, "danger"); }
}

async function loadProducts() {
  const r = await api("/api/products");
  productRows = r.rows;
  // 進商品頁預設不顯示列表；若已有查詢條件則就地更新結果頁的資料（不切換畫面）
  if (prodSearched) { applyProductFilter(); renderProductPage(); }
}

// 查詢欄位與建檔欄位共用（p-category/p-brand/p-model_name/p-supplier）
// 分類精確、其餘含比對；只計算結果，不負責畫面切換
function applyProductFilter() {
  const cat = $("p-category").value;
  const brand = $("p-brand").value.trim().toLowerCase();
  const model = $("p-model_name").value.trim().toLowerCase();
  const sup = $("p-supplier").value.trim().toLowerCase();
  const has = (v, q) => !q || String(v || "").toLowerCase().includes(q);
  prodFiltered = productRows.filter(p =>
    (!cat || p.category === cat) &&
    has(p.brand, brand) && has(p.model_name, model) && has(p.supplier, sup));
  return prodFiltered.length;
}

// 使用者按「查詢」：有結果才切到結果頁（比照客戶查詢）
function searchProducts() {
  const cat = $("p-category").value;
  if (!cat && !$("p-brand").value.trim() && !$("p-model_name").value.trim()
      && !$("p-supplier").value.trim()) {
    setStatus("請至少輸入「分類／品牌／型號／供應商」其中一項再查詢。", "info");
    return;
  }
  prodSearched = true;
  prodPage = 1;
  if (applyProductFilter() === 0) {
    setStatus("查無符合條件的商品。", "info");
    return;
  }
  hideStatus();
  renderProductPage();
  showView("prod-results");
  window.scrollTo(0, 0);
}

function prodGoPage(delta) {
  const size = +$("prod-page-size").value;
  const pages = Math.max(1, Math.ceil(prodFiltered.length / size));
  prodPage = Math.min(pages, Math.max(1, prodPage + delta));
  renderProductPage();
}

function renderProductPage() {
  const size = +$("prod-page-size").value;
  const total = prodFiltered.length;
  const pages = Math.max(1, Math.ceil(total / size));
  if (prodPage > pages) prodPage = pages;
  const start = (prodPage - 1) * size;
  const rows = prodFiltered.slice(start, start + size);
  $("prod-count").textContent = `（${total} 筆）`;
  $("prod-body").innerHTML = rows.map(p => `
    <tr onclick="editProduct(${p.id})"${p.is_active ? "" : ' style="opacity:.55"'}>
      <td>${esc(codeLabel("product_category", p.category))}</td>
      <td>${esc(p.brand)}</td>
      <td>${esc(p.model_name)}</td>
      <td>${esc(p.spec) || "—"}</td>
      <td class="price-col">${p.list_price != null ? Number(p.list_price).toLocaleString() : "—"}</td>
      <td>${p.warranty_months ? p.warranty_months + " 個月" : "—"}</td>
      <td>${p.subsidy_class ? esc(codeLabel("subsidy_class", p.subsidy_class)) : "—"}</td>
      <td>${p.is_active ? "在售" : "停售"}</td>
    </tr>`).join("") || `<tr><td colspan="8" class="hint">查無符合條件的商品。</td></tr>`;
  // 分頁列：只有一頁時隱藏（比照客戶查詢結果）
  $("prod-pager").classList.toggle("hidden", pages <= 1);
  $("prod-page-info").textContent = `第 ${prodPage} / ${pages} 頁`;
  $("prod-prev").disabled = prodPage <= 1;
  $("prod-next").disabled = prodPage >= pages;
}

function toggleHaFields() {
  const isHA = $("p-category").value === "hearing_aid";
  document.querySelectorAll(".ha-only").forEach(el => el.classList.toggle("hidden", !isHA));
}
$("p-category").addEventListener("change", toggleHaFields);

function productFormData() {
  const d = {};
  for (const f of PRODUCT_INPUT_IDS) d[f] = $("p-"+f).value;
  for (const f of PRODUCT_SELECT_IDS) d[f] = $("p-"+f).value;
  d.ha_bluetooth = getSeg("seg-p-bt");
  d.ha_tcoil = getSeg("seg-p-tcoil");
  d.is_active = getSeg("seg-p-active");
  d.ha_fit_levels = [...document.querySelectorAll("#p-fit input:checked")].map(i => i.value).join(",");
  return d;
}

function editProduct(id) {
  const p = productRows.find(x => x.id === id);
  if (!p) return;
  productEditId = id;
  for (const f of PRODUCT_INPUT_IDS) $("p-"+f).value = p[f] ?? "";
  for (const f of PRODUCT_SELECT_IDS) $("p-"+f).value = p[f] ?? "";
  setSeg("seg-p-bt", p.ha_bluetooth == null ? "" : (p.ha_bluetooth ? "y" : "n"));
  setSeg("seg-p-tcoil", p.ha_tcoil == null ? "" : (p.ha_tcoil ? "y" : "n"));
  setSeg("seg-p-active", p.is_active ? "1" : "0");
  const fit = new Set((p.ha_fit_levels || "").split(","));
  document.querySelectorAll("#p-fit input").forEach(i => i.checked = fit.has(i.value));
  $("prod-form-title").textContent = `編輯商品：${p.brand} ${p.model_name}`;
  $("prod-meta").textContent = p.updated_at
    ? `最後更新 ${DF.fromISODateTime(p.updated_at)}${p.updated_by ? "‧" + p.updated_by : ""}` : "";
  $("btn-prod-save").textContent = "儲存變更";
  $("btn-prod-del").classList.remove("hidden");
  $("view-products").classList.add("mode-prod-edit");   // 編輯既有商品時隱藏查詢鈕
  toggleHaFields();
  showView("products");   // 從結果頁點選 → 切回表單頁編輯
  window.scrollTo(0, 0);
}

function clearProductForm() {
  productEditId = null;
  for (const f of PRODUCT_INPUT_IDS) $("p-"+f).value = "";
  for (const f of PRODUCT_SELECT_IDS) $("p-"+f).value = "";
  setSeg("seg-p-bt", ""); setSeg("seg-p-tcoil", ""); setSeg("seg-p-active", "1");
  document.querySelectorAll("#p-fit input").forEach(i => i.checked = false);
  $("prod-form-title").textContent = "新增商品";
  $("prod-meta").textContent = "";
  $("btn-prod-save").textContent = "建立商品";
  $("btn-prod-del").classList.add("hidden");
  $("view-products").classList.remove("mode-prod-edit");   // 回到新增/查詢模式，顯示查詢鈕
  prodSearched = false;
  toggleHaFields();
}

async function saveProduct() {
  hideStatus();
  const d = productFormData();
  if (!d.category || !d.brand.trim() || !d.model_name.trim()) {
    setStatus("「分類」「品牌」「型號」為必填。", "danger");
    return;
  }
  try {
    if (productEditId === null) {
      await api("/api/products", { method: "POST", body: JSON.stringify(d) });
      setStatus("商品已建立。", "success");
      clearProductForm();
    } else {
      await api(`/api/products/${productEditId}`, { method: "PUT", body: JSON.stringify(d) });
      setStatus("已儲存變更。", "success");
    }
    await loadProducts();
  } catch (e) { setStatus(e.message, "danger"); }
}

async function deleteProduct() {
  if (productEditId === null) return;
  if (!confirm("確定刪除這筆商品？已有交易紀錄的商品無法刪除（請改「停售」）。")) return;
  try {
    await api(`/api/products/${productEditId}`, { method: "DELETE" });
    setStatus("商品已刪除。", "success");
    clearProductForm();
    await loadProducts();
  } catch (e) { setStatus(e.message, "danger"); }
}

// ── 紙本表單 OCR 匯入（本機 GPU 辨識 → 自動填表 → 人工校對）──
let ocrPendingPhoto = null;   // 辨識用的原稿；建檔成功後自動存入客戶照片
// OCR 上傳影像的長邊上限（px）。2026-07-13 實測：換 Instruct 模型後推論僅 ~13s，
// 影像大小對速度幾乎無影響（prefill 本就 <2s），但對手寫準確度有影響（1280 曾把
// 姓名多讀一字）。故維持 1600 拚準確度；速度靠模型（見 app.py _OCR_MODEL）而非縮圖。
const OCR_MAX_EDGE = 1600;

let ocrTimerId = null, ocrBusy = false;
window.addEventListener("beforeunload", e => {
  if (ocrBusy) { e.preventDefault(); e.returnValue = ""; }  // 辨識中關閉/重整前警告
});
function showOcrOverlay() {
  ocrBusy = true;
  const t0 = Date.now();
  const timer = $("ocr-timer"), hint = $("ocr-hint");
  const tick = () => {
    const s = Math.floor((Date.now() - t0) / 1000);
    timer.textContent = `已處理 ${s} 秒`;
    // 分段安撫文字：手寫多、圖大時較久
    if (s >= 45) hint.innerHTML = "手寫內容較多，仍在辨識中，請再稍候…<br>處理期間請勿離開或關閉本頁。";
  };
  tick();
  ocrTimerId = setInterval(tick, 1000);
  $("ocr-hint").innerHTML = "正在讀取表單內容，完成後會自動填入欄位。<br>處理期間請勿離開或關閉本頁。";
  $("ocr-overlay").classList.remove("hidden");
}
function hideOcrOverlay() {
  ocrBusy = false;
  clearInterval(ocrTimerId); ocrTimerId = null;
  $("ocr-overlay").classList.add("hidden");
}

async function handleOcrFile(file) {
  hideStatus();
  const btns = [$("ocr-camera-btn"), $("ocr-file-btn")];
  btns.forEach(b => { b.disabled = true; });
  $("ocr-camera-btn").textContent = "辨識中…";
  showOcrOverlay();
  try {
    // OCR 走較小尺寸換辨識速度（vision prefill token 隨像素數下降）；
    // 存檔原稿仍走 1600（見 createCustomer 的 uploadPhoto）。太小會傷手寫辨識，
    // 目前 1280 為速度/準確折衷，可調整 OCR_MAX_EDGE。
    const blob = await shrinkImage(file, OCR_MAX_EDGE);
    const res = await fetch("/api/customers/ocr", {
      method: "POST", credentials: "same-origin",
      headers: { "Content-Type": blob.type || "image/jpeg" }, body: blob });
    if (res.status === 401) { showLogin(); throw new Error("未登入"); }
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.detail || `HTTP ${res.status}`);
    const n = applyOcr(data);
    // 存檔留原始檔（清晰），OCR 只用上面的縮小版
    ocrPendingPhoto = { file, name: file.name || "客戶資料表.jpg" };
    const unc = (data.uncertain || []).length;
    setNote("ocr-status", "");
    setStatus(`辨識完成，已填入 ${n} 個欄位` +
      (unc ? `；其中 ${unc} 個欄位辨識沒把握（黃底），請對照原稿核對` : "") +
      "。確認無誤後按「建檔」，原稿照片會自動存入客戶資料。", "success");
  } catch (e) {
    setNote("ocr-status", "");
    setStatus("辨識失敗：" + e.message, "danger");
  } finally {
    hideOcrOverlay();
    btns.forEach(b => { b.disabled = false; });
    $("ocr-camera-btn").textContent = "📷 拍照匯入";
  }
}

function applyOcr(data) {
  const f = data.fields || {};
  let n = 0;
  clearOcrMarks();
  for (const k of TEXT_FIELDS) if (f[k] != null && k !== "notes") { $("f-"+k).value = f[k]; n++; }
  for (const k of DATE_FIELDS) if (f[k]) { $("f-"+k).value = DF.fromISO(f[k]); n++; }  // API 回西元 ISO → 民國顯示
  if (f.gender) { setSeg("seg-gender", f.gender); n++; }
  if (f.subsidy_applied) { setSeg("seg-subsidy", f.subsidy_applied); n++; }
  for (const k of data.uncertain || []) $("f-"+k)?.classList.add("ocr-uncertain");
  refreshSoftChecks();
  refreshDup();
  return n;
}

function clearOcrMarks() {
  document.querySelectorAll(".ocr-uncertain").forEach(el => el.classList.remove("ocr-uncertain"));
}

// ── OCR GPU 載入狀態機（未熱機前鎖住拍照/匯入，載入完成才解鎖）──────
// GPU 平時休眠(≈0W)；使用者按「載入模型」→ 後端輪替挑卡+綁卡+預載(約 2–4 分鐘)。
let ocrPollTimer = null;
const isCoarse = matchMedia("(pointer: coarse)").matches;

function setOcrState(state, extra) {
  const load = $("ocr-load-btn"), cam = $("ocr-camera-btn"), file = $("ocr-file-btn");
  const importable = state === "ready";
  file.disabled = !importable;
  cam.disabled = !importable;
  if (state === "loading") {
    load.disabled = true;
    load.textContent = "載入中…" + (extra?.elapsed ? ` ${extra.elapsed}s` : "");
    setNote("ocr-status", "GPU 熱機中，約需 2–4 分鐘（載入模型到顯示卡），完成後即可拍照/匯入。");
  } else if (state === "ready") {
    load.disabled = false;
    load.textContent = "✔︎ 已載入";
    if ($("ocr-status").textContent.startsWith("GPU 熱機")) setNote("ocr-status", "");
  } else {  // idle / error
    load.disabled = false;
    load.textContent = "🔌 載入模型";
    if (state === "error") setStatus("模型載入失敗：" + (extra?.error || "請重試"), "danger");
  }
}

async function warmupOcr() {
  try {
    const r = await api("/api/ocr/warmup", { method: "POST" });
    if (r.state === "ready") { setOcrState("ready"); return; }
    setOcrState("loading");
    pollOcrStatus();
  } catch (e) { setStatus(e.message, "danger"); }
}

async function pollOcrStatus() {
  clearTimeout(ocrPollTimer);
  let s;
  try { s = await api("/api/ocr/status"); } catch { return; }
  setOcrState(s.state, s);
  if (s.state === "loading") ocrPollTimer = setTimeout(pollOcrStatus, 4000);
}

// 進入建檔模式時同步一次狀態（別的分頁/前一次已載入就直接解鎖）
async function refreshOcrState() {
  try {
    const s = await api("/api/ocr/status");
    setOcrState(s.state === "ready" ? "ready" : "idle");
    if (s.state === "loading") { setOcrState("loading"); pollOcrStatus(); }
  } catch {}
}

// 閒置自動休眠：留在客戶表單頁時每分鐘同步一次狀態，
// 伺服器休眠後「已載入」會自動退回「載入模型」並鎖回拍照/匯入。
setInterval(() => {
  if (ocrBusy || ocrPollTimer) return;                 // 辨識中/載入輪詢中不打擾
  if ($("view-form").classList.contains("hidden")) return; // 不在客戶頁不查
  refreshOcrState();
}, 60000);

for (const inputId of ["ocr-camera", "ocr-file"]) {
  $(inputId).addEventListener("change", e => {
    const file = e.target.files[0];
    e.target.value = "";
    if (file) handleOcrFile(file);
  });
}
// 使用者修改欄位即解除黃框（已人工確認）
document.querySelectorAll("#view-form input, #view-form textarea").forEach(el =>
  el.addEventListener("input", () => el.classList.remove("ocr-uncertain")));
// 桌機沒有相機，只留檔案匯入
if (!matchMedia("(pointer: coarse)").matches) $("ocr-camera-btn").classList.add("hidden");

// ── 重複客戶偵測（姓名/手機/身分證 失焦時觸發）──────────────
async function refreshDup() {
  confirmCreate = false;
  if (detailId !== null) return;  // 明細編輯模式不偵測
  // 直接讀三個文字欄位（不經 formData：日期欄可能尚在輸入中、還不是合法格式）
  const name = $("f-name").value, phone_mobile = $("f-phone_mobile").value,
        national_id = $("f-national_id").value;
  if (!name.trim() && !phone_mobile.trim() && !national_id.trim()) { hideDup(); return; }
  try {
    const r = await api("/api/customers/dup", { method: "POST",
      body: JSON.stringify({ name, phone_mobile, national_id }) });
    if (r.rows.length === 0) { hideDup(); return; }
    $("dup-count").textContent = r.rows.length;
    $("dup-list").innerHTML = r.rows.map(x => `
      <li><a href="javascript:openDetail(${x.id})">${x.name}</a>
        <span class="dup-meta">${x.customer_code}${x.phone_mobile ? "‧"+x.phone_mobile : ""}${x.birth_date ? "‧"+DF.fromISO(x.birth_date) : ""}</span>
      </li>`).join("");
    $("dup-panel").classList.remove("hidden");
  } catch { /* 離線等狀況不擋輸入 */ }
}
function hideDup() { $("dup-panel").classList.add("hidden"); $("dup-list").innerHTML = ""; }

for (const f of ["name","phone_mobile","national_id"])
  $("f-"+f).addEventListener("blur", refreshDup);

// ── 軟性檢核：只提醒、不擋存檔（同 Blazor 版規則）───────────
const LETTER_VALUES = [10,11,12,13,14,15,16,17,34,18,19,20,21,
                       22,35,23,24,25,26,27,28,29,32,30,31,33];
function nidChecksum(id) {
  const letter = LETTER_VALUES[id.charCodeAt(0) - 65];
  let sum = Math.floor(letter / 10) + (letter % 10) * 9;
  const w = [8,7,6,5,4,3,2,1,1];
  for (let i = 0; i < 9; i++) sum += (id.charCodeAt(i + 1) - 48) * w[i];
  return sum % 10 === 0;
}
function nidWarning() {
  const id = $("f-national_id").value.trim().toUpperCase();
  if (!id) return null;
  if (!/^[A-Z][1289][0-9]{8}$/.test(id))
    return "格式不符：應為 1 個大寫字母 + 9 碼數字（新式居留證同格式）。仍可儲存。";
  if (!nidChecksum(id)) return "檢查碼不正確，請再核對一次。仍可儲存。";
  const idMale = id[1] === "1" || id[1] === "8";
  const g = getSeg("seg-gender");
  if (g === "M" && !idMale) return "身分證第 2 碼顯示為女性，與「性別：男」不一致。";
  if (g === "F" && idMale) return "身分證第 2 碼顯示為男性，與「性別：女」不一致。";
  return null;
}
function mobileWarning() {
  const m = $("f-phone_mobile").value.trim();
  if (!m || /^09\d{8}$/.test(m.replaceAll("-",""))) return null;
  return "台灣手機通常是 09 開頭共 10 碼，請確認。仍可儲存（市話請填市話欄）。";
}
function emailWarning() {
  const e = $("f-email").value.trim();
  if (!e || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e)) return null;
  return "Email 格式看起來不完整，請確認。仍可儲存。";
}
function birthInfo() {
  const v = $("f-birth_date").value;
  if (!v.trim()) return null;
  const iso = DF.tryToISO(v);   // 即時回饋：民國輸入→西元確認
  if (iso === null) return `日期格式不正確，請輸入${DF.placeholder}`;
  const b = new Date(iso + "T00:00:00"), now = new Date();
  let age = now.getFullYear() - b.getFullYear();
  const m = now.getMonth() - b.getMonth();
  if (m < 0 || (m === 0 && now.getDate() < b.getDate())) age--;
  return `西元 ${b.getFullYear()} 年‧現年 ${age} 歲`;
}
function setNote(id, text) {
  $(id).textContent = text || "";
  $(id).classList.toggle("hidden", !text);
}
function refreshSoftChecks() {
  setNote("warn-nid", nidWarning());
  setNote("warn-mobile", mobileWarning());
  setNote("warn-email", emailWarning());
  setNote("birth-info", birthInfo());
}
for (const f of ["national_id","phone_mobile","email","birth_date"])
  $("f-"+f).addEventListener("input", refreshSoftChecks);
$("seg-gender").addEventListener("click", refreshSoftChecks);

// ── 行事曆（回訪提醒；型別/顏色沿用舊系統）────────────────────
const REMINDER_TYPES = {
  follow_up:           { label: "回診",     color: "#1d6fd8" },
  maintenance:         { label: "保養",     color: "#188554" },
  battery_replacement: { label: "電池更換", color: "#c05600" },
  tuning:              { label: "調機",     color: "#6f42c1" },
  other:               { label: "其他",     color: "#5c636a" },
};
const rType = t => REMINDER_TYPES[t] || REMINDER_TYPES.other;
const esc = s => (s ?? "").toString()
  .replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;");
const isoDate = d =>
  `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;

let calYear, calMonth;   // 目前顯示的年/月（month 0-based）
let calEvents = {};      // 日期字串 → 當日事件陣列
let calById = {};        // id → 事件

$("cal-legend").innerHTML = Object.values(REMINDER_TYPES).map(t =>
  `<span class="legend-chip"><span class="legend-dot" style="background:${t.color}"></span>${t.label}</span>`).join("");
$("cal-head").innerHTML = ["日","一","二","三","四","五","六"].map(d => `<div>${d}</div>`).join("");

function calToday() {
  const n = new Date();
  calYear = n.getFullYear(); calMonth = n.getMonth();
  loadCalendar();
}
function calShift(d) {
  calMonth += d;
  if (calMonth < 0) { calMonth = 11; calYear--; }
  if (calMonth > 11) { calMonth = 0; calYear++; }
  loadCalendar();
}

function calGridStart() {
  const first = new Date(calYear, calMonth, 1);
  const s = new Date(first);
  s.setDate(1 - first.getDay());   // 從週日開始
  return s;
}

async function loadCalendar() {
  $("cal-title").textContent = `${DF.yearLabel(calYear)} ${calMonth + 1} 月`;
  const start = calGridStart();
  const end = new Date(start); end.setDate(start.getDate() + 42);
  try {
    const r = await api(`/api/calendar?start=${isoDate(start)}&end=${isoDate(end)}`);
    calEvents = {}; calById = {};
    for (const ev of r.rows) {
      (calEvents[ev.scheduled_date] ??= []).push(ev);
      calById[ev.id] = ev;
    }
    renderCalendar(start);
  } catch { /* 401 已導回登入 */ }
}

function evChip(ev) {
  const t = rType(ev.reminder_type);
  const done = ev.status === "completed";
  return `<div class="cal-ev${done ? " done" : ""}" style="background:${t.color}"
    onclick="showReminder(${ev.id})" title="${esc(t.label)}‧${esc(ev.customer_name)}">${esc(t.label)}‧${esc(ev.customer_name)}</div>`;
}

function renderCalendar(gridStart) {
  const MAX_SHOWN = 3, todayIso = today();
  let html = "";
  for (let i = 0; i < 42; i++) {
    const d = new Date(gridStart); d.setDate(gridStart.getDate() + i);
    const dIso = isoDate(d);
    const evs = calEvents[dIso] || [];
    const cls = ["cal-cell",
                 d.getMonth() !== calMonth ? "out" : "",
                 dIso === todayIso ? "today" : ""].filter(Boolean).join(" ");
    let cell = `<div class="cal-daynum">${d.getDate()}</div>` +
               evs.slice(0, MAX_SHOWN).map(evChip).join("");
    if (evs.length > MAX_SHOWN)
      cell += `<div class="cal-more" onclick="showDay('${dIso}')">還有 ${evs.length - MAX_SHOWN} 筆</div>`;
    html += `<div class="${cls}">${cell}</div>`;
  }
  $("cal-body").innerHTML = html;
}

// ── 對話框 ───────────────────────────────────────────────────
function openModal(title, bodyHtml) {
  $("modal-title").textContent = title;
  $("modal-body").innerHTML = bodyHtml;
  $("modal-overlay").classList.remove("hidden");
}
function closeModal() { $("modal-overlay").classList.add("hidden"); }
$("modal-overlay").addEventListener("click", e => {
  if (e.target === $("modal-overlay")) closeModal();
});
document.addEventListener("keydown", e => { if (e.key === "Escape") closeModal(); });

const WEEKDAYS = ["週日","週一","週二","週三","週四","週五","週六"];
function dateLabel(dIso) {
  const d = new Date(dIso + "T00:00:00");
  return `${DF.fromISO(dIso)}（${WEEKDAYS[d.getDay()]}）`;
}

function showReminder(id) {
  const ev = calById[id];
  if (!ev) return;
  const t = rType(ev.reminder_type);
  openModal(`${t.label}提醒`, `
    <div><strong>客戶：</strong>${esc(ev.customer_name)}</div>
    <div><strong>電話：</strong>${esc(ev.phone) || "—"}</div>
    <div><strong>日期：</strong>${dateLabel(ev.scheduled_date)}</div>
    <div><strong>狀態：</strong>${ev.status === "completed" ? "已完成" : "待處理"}</div>
    ${ev.notes ? `<div><strong>備註：</strong>${esc(ev.notes)}</div>` : ""}
    <div class="modal-actions">
      <button class="btn outline" onclick="closeModal();openDetail(${ev.customer_id})">開啟客戶資料</button>
      <button class="btn ghost" onclick="closeModal()">關閉</button>
    </div>`);
}

function showDay(dIso) {
  const evs = calEvents[dIso] || [];
  openModal(dateLabel(dIso), evs.map(evChip).join("") || "<div>本日沒有提醒。</div>");
}

// ── 其他 ─────────────────────────────────────────────────────
function copyHousehold() {
  for (const p of ["city","district","village","detail"])
    $("f-mailing_"+p).value = $("f-household_"+p).value;
}
function copyMailing() {
  for (const p of ["city","district","village","detail"])
    $("f-household_"+p).value = $("f-mailing_"+p).value;
}
// 訊息一律走 #toast 浮層（固定於可視上緣、白底紅框紅字），15 秒自動收合。
let toastTimer = null;
function setStatus(text, css) {
  $("toast-text").textContent = text;
  $("toast").className = `banner ${css}`;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(hideStatus, 15000);
}
function hideStatus() { $("toast").className = "banner hidden"; clearTimeout(toastTimer); }
function setBusy(b) {
  for (const id of ["btn-create","btn-query","btn-save"]) $(id).disabled = b;
  document.querySelectorAll(".fq-btn").forEach(el => el.disabled = b);
}

// ── 登入頁動態小點特效（參考 antigravity.google）─────────────
// 整面小圓點輕微漂浮；游標靠近時被推開並變亮變大，離開後平滑彈回。
try {
  (() => {
    const cv = $("login-fx"), ctx = cv.getContext("2d");
    const GAP = 36, WOBBLE = 3, R_MOUSE = 150, PUSH = 30;
    let dots = [], W = 0, H = 0;
    const mouse = { x: -1e4, y: -1e4 };

    function build() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight;
      cv.width = W * dpr; cv.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      dots = [];
      for (let y = GAP / 2; y < H; y += GAP)
        for (let x = GAP / 2; x < W; x += GAP)
          dots.push({ x, y, r: 1.1 + Math.random() * 1.2,
                      p: Math.random() * Math.PI * 2,     // 相位：每點漂浮節奏不同
                      s: .35 + Math.random() * .5,        // 速度
                      dx: 0, dy: 0 });                    // 目前被游標推開的位移
    }
    addEventListener("resize", build);
    addEventListener("pointermove", e => { mouse.x = e.clientX; mouse.y = e.clientY; });
    document.documentElement.addEventListener("mouseleave", () => { mouse.x = mouse.y = -1e4; });

    function frame(t) {
      requestAnimationFrame(frame);
      if ($("view-login").classList.contains("hidden")) return;
      const col = currentTheme() === "dark" ? "213,37,63" : "200,16,46";  // 企業紅
      const tt = t / 1000;
      ctx.clearRect(0, 0, W, H);
      for (const d of dots) {
        const wx = Math.cos(tt * d.s + d.p) * WOBBLE;
        const wy = Math.sin(tt * d.s * 1.3 + d.p) * WOBBLE;
        const mx = d.x + wx - mouse.x, my = d.y + wy - mouse.y;
        const dist = Math.hypot(mx, my);
        let tx = 0, ty = 0, boost = 0;
        if (dist < R_MOUSE && dist > .01) {
          boost = 1 - dist / R_MOUSE;
          tx = mx / dist * boost * PUSH;
          ty = my / dist * boost * PUSH;
        }
        d.dx += (tx - d.dx) * .08;   // 平滑推開／回彈
        d.dy += (ty - d.dy) * .08;
        const a = Math.min(.18 + .12 * Math.sin(tt * .7 + d.p * 2) + boost * .6, .9);
        ctx.beginPath();
        ctx.arc(d.x + wx + d.dx, d.y + wy + d.dy, d.r + boost * 1.4, 0, 7);
        ctx.fillStyle = `rgba(${col},${a.toFixed(3)})`;
        ctx.fill();
      }
    }
    build();
    requestAnimationFrame(frame);
  })();
} catch (e) { console.warn("login-fx 特效停用：", e); }

boot();
</script>
</body>
</html>
